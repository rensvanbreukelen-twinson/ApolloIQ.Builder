{
  "schema": "apolloiq.blueprint/1",
  "kind": "Unit",
  "name": "PowerManagement",
  "version": "0.1.0",
  "description": "PMS for two gensets and shore power (example 8.5): blackout protection, switchover with sync, shore power, start from blackout.",
  "interfaces": [
    "Base",
    "AutoManual",
    "Resettable"
  ],
  "tags": [
    {
      "group": "FIN",
      "name": "shore_available",
      "dataType": "Bool",
      "description": "Shore power plugged in and live",
      "source": "LocalIO",
      "primary": false
    },
    {
      "group": "CMD",
      "name": "select_gen1",
      "dataType": "Bool",
      "description": "Use GenSet 1 (start from blackout, or switch over)",
      "primary": false
    },
    {
      "group": "CMD",
      "name": "select_gen2",
      "dataType": "Bool",
      "description": "Use GenSet 2 (start from blackout, or switch over)",
      "primary": false
    },
    {
      "group": "OUT",
      "name": "sync_gen1",
      "dataType": "Bool",
      "description": "Sync contact to GenSet 1: vary RPM to match the bus",
      "primary": false
    },
    {
      "group": "OUT",
      "name": "sync_gen2",
      "dataType": "Bool",
      "description": "Sync contact to GenSet 2: vary RPM to match the bus",
      "primary": false
    },
    {
      "group": "SET",
      "name": "blackout_protection",
      "dataType": "Bool",
      "description": "Start the other generator when the running one is lost",
      "initial": "TRUE",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_start_time",
      "dataType": "Real",
      "description": "Start command to ReadyToConnect",
      "unit": "s",
      "initial": "60",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_close_time",
      "dataType": "Real",
      "description": "Breaker close command to closed",
      "unit": "s",
      "initial": "5",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_sync_time",
      "dataType": "Real",
      "description": "Sync contact to sync OK",
      "unit": "s",
      "initial": "60",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "shore_delay",
      "dataType": "Real",
      "description": "Delay between the generator breakers opening and closing the shore breaker",
      "unit": "s",
      "initial": "3",
      "primary": false
    },
    {
      "group": "FIN",
      "name": "sync_ok",
      "dataType": "Bool",
      "description": "Sync is ok contact",
      "source": "LocalIO",
      "primary": false
    }
  ],
  "roles": [
    {
      "name": "GEN1",
      "blueprint": "GenSet"
    },
    {
      "name": "GEN2",
      "blueprint": "GenSet"
    },
    {
      "name": "CB_GEN1",
      "blueprint": "CircuitBreaker"
    },
    {
      "name": "CB_GEN2",
      "blueprint": "CircuitBreaker"
    },
    {
      "name": "CB_SHORE",
      "blueprint": "CircuitBreaker"
    }
  ],
  "states": [
    {
      "name": "Blackout",
      "category": 0,
      "code": 0,
      "initial": true,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "StartGen1",
      "category": 300,
      "code": 300,
      "initial": false,
      "entry": [
        {
          "tag": "GEN1.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_start_time",
        "goTo": "Blackout",
        "alarm": "Gen1StartFailed",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "CloseGen1",
      "category": 300,
      "code": 301,
      "initial": false,
      "entry": [
        {
          "tag": "CB_GEN1.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_close_time",
        "goTo": "Blackout",
        "alarm": "Gen1BreakerNotClosing",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "OnGen1",
      "category": 400,
      "code": 400,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "SyncGen1",
      "category": 300,
      "code": 302,
      "initial": false,
      "entry": [
        {
          "tag": "GEN1.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_sync_time",
        "goTo": "OnGen2",
        "alarm": "Gen1SyncFailed",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "ParallelGen1",
      "category": 400,
      "code": 401,
      "initial": false,
      "entry": [
        {
          "tag": "CB_GEN1.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_close_time",
        "goTo": "OnGen2",
        "alarm": "Gen1ParallelFailed",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "HandoverToGen1",
      "category": 400,
      "code": 402,
      "initial": false,
      "entry": [
        {
          "tag": "CB_GEN2.CMD.set_off",
          "value": "TRUE"
        },
        {
          "tag": "GEN2.CMD.set_off",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": []
    },
    {
      "name": "StartGen2",
      "category": 300,
      "code": 303,
      "initial": false,
      "entry": [
        {
          "tag": "GEN2.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_start_time",
        "goTo": "Blackout",
        "alarm": "Gen2StartFailed",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "CloseGen2",
      "category": 300,
      "code": 304,
      "initial": false,
      "entry": [
        {
          "tag": "CB_GEN2.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_close_time",
        "goTo": "Blackout",
        "alarm": "Gen2BreakerNotClosing",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "OnGen2",
      "category": 400,
      "code": 403,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "SyncGen2",
      "category": 300,
      "code": 305,
      "initial": false,
      "entry": [
        {
          "tag": "GEN2.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_sync_time",
        "goTo": "OnGen1",
        "alarm": "Gen2SyncFailed",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "ParallelGen2",
      "category": 400,
      "code": 404,
      "initial": false,
      "entry": [
        {
          "tag": "CB_GEN2.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_close_time",
        "goTo": "OnGen1",
        "alarm": "Gen2ParallelFailed",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "HandoverToGen2",
      "category": 400,
      "code": 405,
      "initial": false,
      "entry": [
        {
          "tag": "CB_GEN1.CMD.set_off",
          "value": "TRUE"
        },
        {
          "tag": "GEN1.CMD.set_off",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": []
    },
    {
      "name": "ToShore",
      "category": 100,
      "code": 100,
      "initial": false,
      "entry": [
        {
          "tag": "CB_GEN1.CMD.set_off",
          "value": "TRUE"
        },
        {
          "tag": "CB_GEN2.CMD.set_off",
          "value": "TRUE"
        },
        {
          "tag": "GEN1.CMD.set_off",
          "value": "TRUE"
        },
        {
          "tag": "GEN2.CMD.set_off",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": []
    },
    {
      "name": "ShoreDelay",
      "category": 100,
      "code": 101,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.shore_delay",
        "goTo": "CloseShore",
        "alarmKind": "NonReactive",
        "severity": 20
      }
    },
    {
      "name": "CloseShore",
      "category": 300,
      "code": 306,
      "initial": false,
      "entry": [
        {
          "tag": "CB_SHORE.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_close_time",
        "goTo": "Blackout",
        "alarm": "ShoreBreakerNotClosing",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "OnShore",
      "category": 400,
      "code": 406,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": []
    }
  ],
  "transitions": [
    {
      "name": "select_gen1_from_blackout",
      "from": [
        "Blackout"
      ],
      "to": "StartGen1",
      "guard": "CMD.select_gen1",
      "priority": 3
    },
    {
      "name": "gen1_ready",
      "from": [
        "StartGen1"
      ],
      "to": "CloseGen1",
      "guard": "GEN1.STS.state = ReadyToConnect",
      "priority": 2
    },
    {
      "name": "gen1_connected",
      "from": [
        "CloseGen1"
      ],
      "to": "OnGen1",
      "guard": "CB_GEN1.STS.state = Closed",
      "priority": 2
    },
    {
      "name": "switch_to_gen1",
      "from": [
        "OnGen2"
      ],
      "to": "SyncGen1",
      "guard": "CMD.select_gen1",
      "priority": 4
    },
    {
      "name": "gen1_synchronised",
      "from": [
        "SyncGen1"
      ],
      "to": "ParallelGen1",
      "guard": "GEN1.STS.state = ReadyToConnect AND FIN.sync_ok",
      "priority": 2
    },
    {
      "name": "gen1_parallel",
      "from": [
        "ParallelGen1"
      ],
      "to": "HandoverToGen1",
      "guard": "CB_GEN1.STS.state = Closed",
      "priority": 2
    },
    {
      "name": "gen2_disconnected",
      "from": [
        "HandoverToGen1"
      ],
      "to": "OnGen1",
      "guard": "NOT (CB_GEN2.STS.state = Closed)",
      "priority": 2
    },
    {
      "name": "gen1_lost_protected",
      "from": [
        "OnGen1"
      ],
      "to": "StartGen2",
      "guard": "SET.blackout_protection AND STS.auto AND NOT (CB_GEN1.STS.state = Closed AND GEN1.is_running)",
      "priority": 1
    },
    {
      "name": "gen1_lost",
      "from": [
        "OnGen1"
      ],
      "to": "Blackout",
      "guard": "NOT (CB_GEN1.STS.state = Closed)",
      "priority": 2
    },
    {
      "name": "shore_plugged_in_gen1",
      "from": [
        "OnGen1"
      ],
      "to": "ToShore",
      "guard": "FIN.shore_available AND STS.auto",
      "priority": 3
    },
    {
      "name": "select_gen2_from_blackout",
      "from": [
        "Blackout"
      ],
      "to": "StartGen2",
      "guard": "CMD.select_gen2",
      "priority": 3
    },
    {
      "name": "gen2_ready",
      "from": [
        "StartGen2"
      ],
      "to": "CloseGen2",
      "guard": "GEN2.STS.state = ReadyToConnect",
      "priority": 2
    },
    {
      "name": "gen2_connected",
      "from": [
        "CloseGen2"
      ],
      "to": "OnGen2",
      "guard": "CB_GEN2.STS.state = Closed",
      "priority": 2
    },
    {
      "name": "switch_to_gen2",
      "from": [
        "OnGen1"
      ],
      "to": "SyncGen2",
      "guard": "CMD.select_gen2",
      "priority": 4
    },
    {
      "name": "gen2_synchronised",
      "from": [
        "SyncGen2"
      ],
      "to": "ParallelGen2",
      "guard": "GEN2.STS.state = ReadyToConnect AND FIN.sync_ok",
      "priority": 2
    },
    {
      "name": "gen2_parallel",
      "from": [
        "ParallelGen2"
      ],
      "to": "HandoverToGen2",
      "guard": "CB_GEN2.STS.state = Closed",
      "priority": 2
    },
    {
      "name": "gen1_disconnected",
      "from": [
        "HandoverToGen2"
      ],
      "to": "OnGen2",
      "guard": "NOT (CB_GEN1.STS.state = Closed)",
      "priority": 2
    },
    {
      "name": "gen2_lost_protected",
      "from": [
        "OnGen2"
      ],
      "to": "StartGen1",
      "guard": "SET.blackout_protection AND STS.auto AND NOT (CB_GEN2.STS.state = Closed AND GEN2.is_running)",
      "priority": 1
    },
    {
      "name": "gen2_lost",
      "from": [
        "OnGen2"
      ],
      "to": "Blackout",
      "guard": "NOT (CB_GEN2.STS.state = Closed)",
      "priority": 2
    },
    {
      "name": "shore_plugged_in_gen2",
      "from": [
        "OnGen2"
      ],
      "to": "ToShore",
      "guard": "FIN.shore_available AND STS.auto",
      "priority": 3
    },
    {
      "name": "generator_breakers_open",
      "from": [
        "ToShore"
      ],
      "to": "ShoreDelay",
      "guard": "NOT (CB_GEN1.STS.state = Closed) AND NOT (CB_GEN2.STS.state = Closed)",
      "priority": 2
    },
    {
      "name": "shore_from_blackout",
      "from": [
        "Blackout"
      ],
      "to": "CloseShore",
      "guard": "FIN.shore_available AND STS.auto",
      "priority": 2
    },
    {
      "name": "shore_connected",
      "from": [
        "CloseShore"
      ],
      "to": "OnShore",
      "guard": "CB_SHORE.STS.state = Closed",
      "priority": 2
    },
    {
      "name": "shore_lost_protected",
      "from": [
        "OnShore"
      ],
      "to": "StartGen1",
      "guard": "SET.blackout_protection AND STS.auto AND NOT (CB_SHORE.STS.state = Closed)",
      "priority": 1
    },
    {
      "name": "shore_lost",
      "from": [
        "OnShore"
      ],
      "to": "Blackout",
      "guard": "NOT (CB_SHORE.STS.state = Closed)",
      "priority": 2
    },
    {
      "name": "shore_unplugged",
      "from": [
        "ShoreDelay",
        "CloseShore"
      ],
      "to": "Blackout",
      "guard": "NOT FIN.shore_available",
      "priority": 1
    }
  ],
  "always": [
    {
      "tag": "OUT.sync_gen1",
      "value": "STS.state = SyncGen1 AND GEN1.STS.state = ReadyToConnect"
    },
    {
      "tag": "OUT.sync_gen2",
      "value": "STS.state = SyncGen2 AND GEN2.STS.state = ReadyToConnect"
    }
  ],
  "alarms": [],
  "plant": [],
  "aliases": {},
  "commandInputs": {
    "rows": [
      {
        "name": "HMI",
        "source": "Hmi",
        "kind": "Pulse",
        "drives": "OnOff",
        "on": null,
        "off": null,
        "inAuto": "Always",
        "location": "Any",
        "commands": [
          "select_gen1",
          "select_gen2",
          "set_auto",
          "set_manual",
          "reset"
        ]
      }
    ],
    "level": false
  },
  "interlocks": [
    {
      "target": "CB_GEN1",
      "kind": "SwitchOn",
      "condition": "GEN1.STS.state = ReadyToConnect",
      "text": "GenSet 1 ready to connect"
    },
    {
      "target": "CB_GEN1",
      "kind": "SwitchOn",
      "condition": "NOT CB_SHORE.is_closed",
      "text": "Shore power not connected"
    },
    {
      "target": "CB_GEN1",
      "kind": "Trip",
      "condition": "NOT GEN1.is_running",
      "text": "GEN1 breaker opened: GenSet 1 not running",
      "alarm": "Gen1NotRunning",
      "severity": 20
    },
    {
      "target": "CB_GEN2",
      "kind": "SwitchOn",
      "condition": "GEN2.STS.state = ReadyToConnect",
      "text": "GenSet 2 ready to connect"
    },
    {
      "target": "CB_GEN2",
      "kind": "SwitchOn",
      "condition": "NOT CB_SHORE.is_closed",
      "text": "Shore power not connected"
    },
    {
      "target": "CB_GEN2",
      "kind": "Trip",
      "condition": "NOT GEN2.is_running",
      "text": "GEN2 breaker opened: GenSet 2 not running",
      "alarm": "Gen2NotRunning",
      "severity": 20
    },
    {
      "target": "CB_SHORE",
      "kind": "SwitchOn",
      "condition": "NOT CB_GEN1.is_closed AND NOT CB_GEN2.is_closed",
      "text": "Generator breakers open"
    }
  ]
}
