{
  "schema": "apolloiq.blueprint/1",
  "kind": "CM",
  "name": "Light",
  "version": "0.1.0",
  "description": "A light with lamp current feedback. Example from 4.10 Blueprint editor.",
  "interfaces": [
    "Base",
    "Switchable",
    "Resettable",
    "Interlocks"
  ],
  "tags": [
    {
      "group": "FIN",
      "name": "feedback",
      "dataType": "Bool",
      "description": "Lamp current detected",
      "source": "LocalIO"
    },
    {
      "group": "OUT",
      "name": "lamp",
      "dataType": "Bool",
      "description": "Lamp coil"
    },
    {
      "group": "PAR",
      "name": "max_switch_time",
      "dataType": "Real",
      "description": "Maximum time to switch",
      "unit": "s",
      "initial": "2"
    },
    {
      "group": "INT",
      "name": "feedback",
      "dataType": "Bool",
      "description": "Conditioned feedback"
    }
  ],
  "states": [
    {
      "name": "Off",
      "category": 200,
      "initial": true,
      "run": [
        {
          "tag": "OUT.lamp",
          "value": "FALSE"
        }
      ]
    },
    {
      "name": "TurningOn",
      "category": 300,
      "run": [
        {
          "tag": "OUT.lamp",
          "value": "TRUE"
        }
      ],
      "timeout": {
        "time": "PAR.max_switch_time",
        "goTo": "Broken",
        "alarm": "DoesNotSwitchOn",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "On",
      "category": 400,
      "run": [
        {
          "tag": "OUT.lamp",
          "value": "TRUE"
        }
      ]
    },
    {
      "name": "TurningOff",
      "category": 100,
      "run": [
        {
          "tag": "OUT.lamp",
          "value": "FALSE"
        }
      ],
      "timeout": {
        "time": "PAR.max_switch_time",
        "goTo": "Broken"
      }
    },
    {
      "name": "Broken",
      "category": 500,
      "run": [
        {
          "tag": "OUT.lamp",
          "value": "FALSE"
        }
      ]
    }
  ],
  "transitions": [
    {
      "name": "switch_on",
      "from": [
        "Off"
      ],
      "to": "TurningOn",
      "guard": "CMD.set_on AND LOK.can_on",
      "priority": 10
    },
    {
      "name": "is_on",
      "from": [
        "TurningOn"
      ],
      "to": "On",
      "guard": "INT.feedback",
      "priority": 10
    },
    {
      "name": "switch_off",
      "from": [
        "On"
      ],
      "to": "TurningOff",
      "guard": "CMD.set_off AND LOK.can_off OR LOK.trip",
      "priority": 10
    },
    {
      "name": "is_off",
      "from": [
        "TurningOff"
      ],
      "to": "Off",
      "guard": "NOT INT.feedback",
      "priority": 10
    },
    {
      "name": "reset",
      "from": [
        "Broken"
      ],
      "to": "Off",
      "guard": "CMD.reset",
      "priority": 10
    }
  ],
  "always": [
    {
      "tag": "INT.feedback",
      "value": "FIN.feedback"
    },
    {
      "tag": "STS.remote_ok",
      "value": "STS.enabled"
    }
  ],
  "alarms": [
    {
      "name": "LampFailure",
      "kind": "NonReactive",
      "condition": "STS.state = On AND time(NOT INT.feedback) > 1",
      "severity": 10,
      "message": "Lamp failure"
    }
  ],
  "plant": [
    {
      "tag": "FIN.feedback",
      "value": "OUT.lamp"
    }
  ],
  "commandInputs": {
    "rows": [
      {
        "name": "HMI",
        "source": "Hmi",
        "kind": "Pulse",
        "drives": "OnOff",
        "on": 1,
        "off": 1,
        "inAuto": "Ignore",
        "location": "Any",
        "commands": [
          "reset"
        ]
      },
      {
        "name": "BOARD",
        "source": "DigitalInput",
        "kind": "Button",
        "drives": "Toggle",
        "on": 1,
        "off": 1,
        "inAuto": "Always",
        "location": "Any",
        "debounce": 0.05
      }
    ],
    "level": false
  }
}
