{
  "schema": "apolloiq.blueprint/1",
  "kind": "CM",
  "name": "PushButton",
  "version": "0.1.0",
  "description": "Hardwired push button or switch, used as a command source (wire it to a CM with On, Off, Toggle or Maintained)",
  "interfaces": [
    "Base",
    "Resettable"
  ],
  "tags": [
    {
      "group": "FIN",
      "name": "pressed",
      "dataType": "Bool",
      "description": "Contact closed",
      "source": "LocalIO",
      "primary": true
    },
    {
      "group": "INT",
      "name": "pressed",
      "dataType": "Bool",
      "description": "Conditioned contact",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "button_stick_time",
      "dataType": "Int",
      "description": "Watchdog timer for button stick",
      "unit": "s",
      "initial": "30",
      "primary": false
    }
  ],
  "roles": [],
  "states": [
    {
      "name": "Released",
      "category": 200,
      "code": 200,
      "initial": true,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "Pressed",
      "category": 400,
      "code": 400,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "10",
        "goTo": "Fault",
        "alarm": "Button_Stick",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "Fault",
      "category": 500,
      "code": 500,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": []
    }
  ],
  "transitions": [
    {
      "name": "pressed",
      "from": [
        "Released"
      ],
      "to": "Pressed",
      "guard": "INT.pressed",
      "priority": 1
    },
    {
      "name": "released",
      "from": [
        "Pressed"
      ],
      "to": "Released",
      "guard": "NOT INT.pressed",
      "priority": 1
    },
    {
      "name": "fault",
      "from": [
        "Fault"
      ],
      "to": "Released",
      "guard": "TRUE",
      "priority": 10
    }
  ],
  "always": [
    {
      "tag": "STS.remote_ok",
      "value": "FALSE"
    }
  ],
  "alarms": []
}
