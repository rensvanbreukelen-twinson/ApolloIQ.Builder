{
  "schema": "apolloiq.blueprint/1",
  "kind": "EM",
  "name": "GenSetPowerSource",
  "version": "0.1.0",
  "description": "Equipment module (4.11): brings one generator onto the bus and takes it off again. Roles: ENGINE (GenSet), BREAKER (CircuitBreaker), METER (PowerMeter). Synchronising is done here, never in the breaker (G-158).",
  "interfaces": [
    "Base",
    "Switchable",
    "Resettable",
    "Interlocks",
    "AutoManual"
  ],
  "tags": [
    {
      "group": "OUT",
      "name": "sync_request",
      "dataType": "Bool",
      "description": "Sync contact to the synchroniser: match the generator to the bus",
      "primary": false
    },
    {
      "group": "FIN",
      "name": "sync_ok",
      "dataType": "Bool",
      "description": "Sync OK from the synchroniser (check relay)",
      "source": "LocalIO",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "rated_kw",
      "dataType": "Real",
      "description": "Rated power of this set",
      "unit": "kW",
      "initial": "500",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "unload_kw",
      "dataType": "Real",
      "description": "Load below which the breaker may open on a normal stop",
      "unit": "kW",
      "initial": "25",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_start_time",
      "dataType": "Real",
      "description": "Start command to ready to connect",
      "unit": "s",
      "initial": "60",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_sync_time",
      "dataType": "Real",
      "description": "Sync and close",
      "unit": "s",
      "initial": "60",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_unload_time",
      "dataType": "Real",
      "description": "Unloading before the breaker opens anyway",
      "unit": "s",
      "initial": "60",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_open_time",
      "dataType": "Real",
      "description": "Breaker open command to open",
      "unit": "s",
      "initial": "5",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_stop_time",
      "dataType": "Real",
      "description": "Engine stop command to stopped, including cooldown",
      "unit": "s",
      "initial": "600",
      "primary": false
    },
    {
      "group": "STS",
      "name": "active_power",
      "dataType": "Real",
      "description": "Active power of this set (from the meter)",
      "unit": "kW",
      "primary": true
    },
    {
      "group": "STS",
      "name": "available_kw",
      "dataType": "Real",
      "description": "Spare power while on the bus",
      "unit": "kW",
      "primary": false
    },
    {
      "group": "STS",
      "name": "on_bus",
      "dataType": "Bool",
      "description": "Breaker closed and engine running",
      "primary": false
    },
    {
      "group": "INT",
      "name": "reset_request",
      "dataType": "Bool",
      "description": "Reset asked while in Shutdown; kept until the members are healthy",
      "primary": false
    }
  ],
  "roles": [
    {
      "name": "ENGINE",
      "blueprint": "GenSet"
    },
    {
      "name": "BREAKER",
      "blueprint": "CircuitBreaker"
    },
    {
      "name": "METER",
      "blueprint": "PowerMeter"
    }
  ],
  "states": [
    {
      "name": "Stopped",
      "category": 0,
      "code": 0,
      "initial": true,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "Available",
      "category": 200,
      "code": 200,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "Starting",
      "category": 300,
      "code": 300,
      "initial": false,
      "entry": [
        {
          "tag": "ENGINE.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_start_time",
        "goTo": "Shutdown",
        "alarm": "FailedToStart",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "Connecting",
      "category": 300,
      "code": 300,
      "initial": false,
      "entry": [],
      "run": [
        {
          "tag": "BREAKER.CMD.set_on",
          "value": "FIN.sync_ok"
        }
      ],
      "exit": [],
      "timeout": {
        "time": "PAR.max_sync_time",
        "goTo": "Shutdown",
        "alarm": "FailedToConnect",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "Running",
      "category": 400,
      "code": 400,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "Unloading",
      "category": 100,
      "code": 100,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_unload_time",
        "goTo": "Disconnecting",
        "alarm": "NotUnloaded",
        "alarmKind": "NonReactive",
        "severity": 15
      }
    },
    {
      "name": "Disconnecting",
      "category": 100,
      "code": 100,
      "initial": false,
      "entry": [
        {
          "tag": "BREAKER.CMD.set_off",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_open_time",
        "goTo": "Shutdown",
        "alarm": "FailedToOpen",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "StoppingEngine",
      "category": 100,
      "code": 100,
      "initial": false,
      "entry": [
        {
          "tag": "ENGINE.CMD.set_off",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_stop_time",
        "goTo": "Shutdown",
        "alarm": "FailedToStop",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "Shutdown",
      "category": 500,
      "code": 500,
      "initial": false,
      "entry": [
        {
          "tag": "BREAKER.CMD.set_off",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": []
    }
  ],
  "transitions": [
    {
      "name": "member_fault",
      "from": [
        "Starting",
        "Connecting",
        "Running",
        "Unloading",
        "Disconnecting"
      ],
      "to": "Shutdown",
      "guard": "BREAKER.STS.state = Tripped OR ENGINE.STS.state = Shutdown",
      "priority": 1
    },
    {
      "name": "breaker_lost",
      "from": [
        "Running"
      ],
      "to": "Shutdown",
      "guard": "NOT (BREAKER.STS.state = Closed)",
      "priority": 2
    },
    {
      "name": "ready",
      "from": [
        "Stopped"
      ],
      "to": "Available",
      "guard": "ENGINE.STS.state = Available AND BREAKER.STS.state = Open",
      "priority": 10
    },
    {
      "name": "not_ready",
      "from": [
        "Available"
      ],
      "to": "Stopped",
      "guard": "NOT (ENGINE.STS.state = Available AND BREAKER.STS.state = Open)",
      "priority": 10
    },
    {
      "name": "start",
      "from": [
        "Available"
      ],
      "to": "Starting",
      "guard": "LOK.can_on AND CMD.set_on",
      "priority": 10
    },
    {
      "name": "start_aborted",
      "from": [
        "Starting"
      ],
      "to": "StoppingEngine",
      "guard": "CMD.set_off AND LOK.can_off",
      "priority": 10
    },
    {
      "name": "ready_to_connect",
      "from": [
        "Starting"
      ],
      "to": "Connecting",
      "guard": "ENGINE.STS.state = ReadyToConnect",
      "priority": 10
    },
    {
      "name": "connect_aborted",
      "from": [
        "Connecting"
      ],
      "to": "StoppingEngine",
      "guard": "CMD.set_off AND LOK.can_off",
      "priority": 10
    },
    {
      "name": "connected",
      "from": [
        "Connecting"
      ],
      "to": "Running",
      "guard": "BREAKER.STS.state = Closed AND ENGINE.STS.state = ReadyToConnect",
      "priority": 10
    },
    {
      "name": "stop",
      "from": [
        "Running"
      ],
      "to": "Unloading",
      "guard": "(CMD.set_off AND LOK.can_off) OR LOK.trip",
      "priority": 10
    },
    {
      "name": "unloaded",
      "from": [
        "Unloading"
      ],
      "to": "Disconnecting",
      "guard": "METER.FIN.active_power < PAR.unload_kw",
      "priority": 10
    },
    {
      "name": "disconnected",
      "from": [
        "Disconnecting"
      ],
      "to": "StoppingEngine",
      "guard": "BREAKER.STS.state = Open OR BREAKER.STS.state = OpenNotReady",
      "priority": 10
    },
    {
      "name": "engine_stopped",
      "from": [
        "StoppingEngine"
      ],
      "to": "Stopped",
      "guard": "ENGINE.STS.state = Stopped OR ENGINE.STS.state = Available",
      "priority": 10
    },
    {
      "name": "reset",
      "from": [
        "Shutdown"
      ],
      "to": "Stopped",
      "guard": "INT.reset_request AND NOT (BREAKER.STS.state = Tripped) AND NOT (ENGINE.STS.state = Shutdown)",
      "priority": 10
    }
  ],
  "always": [
    {
      "tag": "STS.remote_ok",
      "value": "STS.enabled AND ENGINE.STS.remote_ok AND BREAKER.STS.remote_ok"
    },
    {
      "tag": "OUT.sync_request",
      "value": "STS.state = Connecting AND NOT FIN.sync_ok"
    },
    {
      "tag": "STS.active_power",
      "value": "METER.FIN.active_power"
    },
    {
      "tag": "STS.on_bus",
      "value": "STS.state = Running"
    },
    {
      "tag": "STS.available_kw",
      "value": "SEL(STS.on_bus, 0, MAX(0, PAR.rated_kw - METER.FIN.active_power))"
    },
    {
      "tag": "INT.reset_request",
      "value": "STS.state = Shutdown AND (INT.reset_request OR CMD.reset)"
    }
  ],
  "alarms": [],
  "plant": [
    {
      "tag": "FIN.sync_ok",
      "value": "time(OUT.sync_request) > 2"
    }
  ],
  "commandInputs": {
    "rows": [
      {
        "name": "HMI",
        "source": "Hmi",
        "kind": "Pulse",
        "drives": "OnOff",
        "on": 1,
        "off": 1,
        "inAuto": "Ignore",
        "location": "Any",
        "commands": [
          "reset"
        ]
      }
    ],
    "level": false
  },
  "interlocks": [
    {
      "target": "BREAKER",
      "kind": "SwitchOn",
      "condition": "ENGINE.is_running",
      "text": "Engine running"
    },
    {
      "target": "BREAKER",
      "kind": "Trip",
      "condition": "NOT ENGINE.is_running",
      "text": "Breaker opened: engine not running",
      "alarm": "EngineNotRunning",
      "severity": 20,
      "escalate": "EM"
    },
    {
      "target": "ENGINE",
      "kind": "SwitchOff",
      "condition": "NOT BREAKER.is_closed",
      "text": "Breaker open"
    }
  ]
}
