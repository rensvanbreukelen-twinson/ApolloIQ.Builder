{
  "schema": "apolloiq.blueprint/1",
  "kind": "CM",
  "name": "GenSet",
  "version": "0.1.0",
  "description": "Diesel engine plus generator with an external genset controller. The breaker is a separate CM; a PMS Unit coordinates both.",
  "interfaces": [
    "Base",
    "Switchable",
    "Resettable",
    "Interlocks"
  ],
  "tags": [
    {
      "group": "FIN",
      "name": "running",
      "dataType": "Bool",
      "description": "Engine running",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "ready",
      "dataType": "Bool",
      "description": "Ready to start: no shutdown or start block in the controller",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "in_auto",
      "dataType": "Bool",
      "description": "Controller in auto",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "shutdown_active",
      "dataType": "Bool",
      "description": "Engine protection shutdown active",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "common_alarm",
      "dataType": "Bool",
      "description": "Controller common alarm",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "common_warning",
      "dataType": "Bool",
      "description": "Controller common warning",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "frequency",
      "dataType": "Real",
      "unit": "Hz",
      "min": 0,
      "max": 70,
      "description": "Generator frequency",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "voltage",
      "dataType": "Real",
      "unit": "V",
      "min": 0,
      "max": 1000,
      "description": "Generator voltage (L-L)",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "current",
      "dataType": "Real",
      "unit": "A",
      "min": 0,
      "max": 5000,
      "description": "Generator current (highest phase)",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "active_power",
      "dataType": "Real",
      "unit": "kW",
      "min": 0,
      "max": 5000,
      "description": "Output power",
      "source": "External",
      "primary": true
    },
    {
      "group": "FIN",
      "name": "coolant_temp",
      "dataType": "Real",
      "unit": "°C",
      "min": 0,
      "max": 150,
      "description": "Coolant temperature",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "lube_oil_pressure",
      "dataType": "Real",
      "unit": "bar",
      "min": 0,
      "max": 10,
      "description": "Lube oil pressure",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "lube_oil_temp",
      "dataType": "Real",
      "unit": "°C",
      "min": 0,
      "max": 150,
      "description": "Lube oil temperature",
      "source": "External"
    },
    {
      "group": "FIN",
      "name": "battery_voltage",
      "dataType": "Real",
      "unit": "V",
      "min": 0,
      "max": 32,
      "description": "Starting battery voltage",
      "source": "External"
    },
    {
      "group": "OUT",
      "name": "start_request",
      "dataType": "Bool",
      "description": "Start the engine"
    },
    {
      "group": "OUT",
      "name": "stop_request",
      "dataType": "Bool",
      "description": "Stop the engine"
    },
    {
      "group": "OUT",
      "name": "reset_request",
      "dataType": "Bool",
      "description": "Controller alarm reset"
    },
    {
      "group": "PAR",
      "name": "max_start_time",
      "dataType": "Real",
      "unit": "s",
      "initial": "30",
      "description": "Start request to running, including crank attempts"
    },
    {
      "group": "PAR",
      "name": "max_unload_time",
      "dataType": "Real",
      "unit": "s",
      "initial": "30",
      "description": "Stop command to breaker open (unloaded)"
    },
    {
      "group": "PAR",
      "name": "max_stop_time",
      "dataType": "Real",
      "unit": "s",
      "initial": "60",
      "description": "Stop request to not running"
    },
    {
      "group": "PAR",
      "name": "cooldown_time",
      "dataType": "Real",
      "unit": "s",
      "initial": "180",
      "description": "Unloaded running time before stop"
    },
    {
      "group": "PAR",
      "name": "stable_time",
      "dataType": "Real",
      "unit": "s",
      "initial": "5",
      "description": "Voltage and frequency in range before ReadyToConnect"
    },
    {
      "group": "PAR",
      "name": "coolant_temp_H",
      "dataType": "Real",
      "unit": "°C",
      "initial": "90",
      "description": "Coolant temperature high"
    },
    {
      "group": "PAR",
      "name": "coolant_temp_HH",
      "dataType": "Real",
      "unit": "°C",
      "initial": "95",
      "description": "Coolant temperature high-high"
    },
    {
      "group": "PAR",
      "name": "lube_oil_pressure_L",
      "dataType": "Real",
      "unit": "bar",
      "initial": "2.5",
      "description": "Lube oil pressure low"
    },
    {
      "group": "PAR",
      "name": "lube_oil_pressure_LL",
      "dataType": "Real",
      "unit": "bar",
      "initial": "1.5",
      "description": "Lube oil pressure low-low"
    },
    {
      "group": "PAR",
      "name": "oil_pressure_delay",
      "dataType": "Real",
      "unit": "s",
      "initial": "10",
      "description": "Oil pressure alarms active after running this long"
    },
    {
      "group": "PAR",
      "name": "lube_oil_temp_H",
      "dataType": "Real",
      "unit": "°C",
      "initial": "105",
      "description": "Lube oil temperature high"
    },
    {
      "group": "PAR",
      "name": "battery_voltage_L",
      "dataType": "Real",
      "unit": "V",
      "initial": "22",
      "description": "Battery voltage low (24 V system)"
    },
    {
      "group": "PAR",
      "name": "overload_pct",
      "dataType": "Real",
      "unit": "%",
      "initial": "100",
      "description": "Overload warning limit"
    },
    {
      "group": "PAR",
      "name": "overload_delay",
      "dataType": "Real",
      "unit": "s",
      "initial": "10",
      "description": "Overload warning delay"
    },
    {
      "group": "PAR",
      "name": "voltage_tol_pct",
      "dataType": "Real",
      "unit": "%",
      "initial": "5",
      "description": "Allowed voltage deviation from rated"
    },
    {
      "group": "PAR",
      "name": "frequency_tol_pct",
      "dataType": "Real",
      "unit": "%",
      "initial": "2",
      "description": "Allowed frequency deviation from rated"
    },
    {
      "group": "SET",
      "name": "rated_power",
      "dataType": "Real",
      "unit": "kW",
      "initial": "500",
      "description": "Nameplate power"
    },
    {
      "group": "SET",
      "name": "rated_voltage",
      "dataType": "Real",
      "unit": "V",
      "initial": "400",
      "description": "Nameplate voltage"
    },
    {
      "group": "SET",
      "name": "rated_frequency",
      "dataType": "Real",
      "unit": "Hz",
      "initial": "50",
      "description": "Nameplate frequency (50 or 60)"
    },
    {
      "group": "SET",
      "name": "cooldown_enabled",
      "dataType": "Bool",
      "initial": "TRUE",
      "description": "Run the cooldown on a normal stop"
    },
    {
      "group": "STS",
      "name": "load_pct",
      "dataType": "Real",
      "unit": "%",
      "description": "active_power / rated_power × 100"
    },
    {
      "group": "STS",
      "name": "cooldown_remaining",
      "dataType": "Real",
      "unit": "s",
      "description": "Remaining cooldown time"
    },
    {
      "group": "INT",
      "name": "running",
      "dataType": "Bool",
      "description": "Conditioned running"
    },
    {
      "group": "INT",
      "name": "ready",
      "dataType": "Bool",
      "description": "Conditioned ready"
    },
    {
      "group": "INT",
      "name": "in_auto",
      "dataType": "Bool",
      "description": "Conditioned controller auto"
    },
    {
      "group": "INT",
      "name": "shutdown_active",
      "dataType": "Bool",
      "description": "Conditioned shutdown"
    },
    {
      "group": "INT",
      "name": "reporting",
      "dataType": "Bool",
      "description": "Controller inputs have good quality"
    },
    {
      "group": "INT",
      "name": "v_ok",
      "dataType": "Bool",
      "description": "Voltage within PAR.voltage_tol_pct of rated"
    },
    {
      "group": "INT",
      "name": "f_ok",
      "dataType": "Bool",
      "description": "Frequency within PAR.frequency_tol_pct of rated"
    },
    {
      "group": "INT",
      "name": "unloaded",
      "dataType": "Bool",
      "description": "Active power below 1 % of rated: the breaker is open"
    },
    {
      "group": "INT",
      "name": "running_timer",
      "dataType": "Real",
      "unit": "s",
      "description": "Time since running rose"
    },
    {
      "group": "INT",
      "name": "stable_timer",
      "dataType": "Real",
      "unit": "s",
      "description": "Time voltage and frequency have been in range"
    },
    {
      "group": "INT",
      "name": "shutdown_latched",
      "dataType": "Bool",
      "description": "Latched shutdown, cleared by CMD.reset"
    },
    {
      "group": "INT",
      "name": "fast_stop",
      "dataType": "Bool",
      "description": "Stop without cooldown because LOK.trip went true"
    }
  ],
  "roles": [],
  "states": [
    {
      "name": "Stopped",
      "category": 0,
      "initial": true,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "Available",
      "category": 200,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "Starting",
      "category": 300,
      "entry": [],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_start_time",
        "goTo": "Stopped",
        "alarm": "FailToStart",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "Running",
      "category": 400,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "ReadyToConnect",
      "category": 400,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "Unloading",
      "category": 100,
      "entry": [],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_unload_time",
        "goTo": "StoppingEngine",
        "alarm": "NotUnloaded",
        "alarmKind": "NonReactive",
        "severity": 15
      }
    },
    {
      "name": "CoolingDown",
      "category": 100,
      "entry": [],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.cooldown_time",
        "goTo": "StoppingEngine"
      }
    },
    {
      "name": "StoppingEngine",
      "category": 100,
      "entry": [],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_stop_time",
        "alarm": "FailToStop",
        "alarmKind": "NonReactive",
        "severity": 25
      }
    },
    {
      "name": "Shutdown",
      "category": 500,
      "entry": [],
      "run": [],
      "exit": []
    }
  ],
  "transitions": [
    {
      "name": "engine_shutdown",
      "from": [
        "Starting",
        "Running",
        "ReadyToConnect",
        "Unloading",
        "CoolingDown",
        "StoppingEngine"
      ],
      "to": "Shutdown",
      "guard": "INT.shutdown_active",
      "priority": 1
    },
    {
      "name": "reset",
      "from": [
        "Shutdown"
      ],
      "to": "Stopped",
      "guard": "NOT INT.shutdown_latched",
      "priority": 1
    },
    {
      "name": "started_locally",
      "from": [
        "Stopped",
        "Available"
      ],
      "to": "Running",
      "guard": "INT.running",
      "priority": 2
    },
    {
      "name": "ready",
      "from": [
        "Stopped"
      ],
      "to": "Available",
      "guard": "INT.ready AND NOT INT.shutdown_active",
      "priority": 3
    },
    {
      "name": "not_ready",
      "from": [
        "Available"
      ],
      "to": "Stopped",
      "guard": "NOT INT.ready OR INT.shutdown_active",
      "priority": 3
    },
    {
      "name": "start",
      "from": [
        "Available"
      ],
      "to": "Starting",
      "guard": "STS.remote_ok AND LOK.can_on AND CMD.set_on",
      "priority": 4
    },
    {
      "name": "running",
      "from": [
        "Starting"
      ],
      "to": "Running",
      "guard": "INT.running",
      "priority": 2
    },
    {
      "name": "start_aborted",
      "from": [
        "Starting"
      ],
      "to": "Stopped",
      "guard": "NOT STS.remote_ok OR (CMD.set_off AND LOK.can_off)",
      "priority": 4
    },
    {
      "name": "stopped_unexpectedly",
      "from": [
        "Running",
        "ReadyToConnect",
        "Unloading",
        "CoolingDown"
      ],
      "to": "Stopped",
      "guard": "NOT INT.running",
      "priority": 2
    },
    {
      "name": "stop",
      "from": [
        "Running",
        "ReadyToConnect"
      ],
      "to": "Unloading",
      "guard": "STS.remote_ok AND ((CMD.set_off AND LOK.can_off) OR LOK.trip)",
      "priority": 3
    },
    {
      "name": "stable",
      "from": [
        "Running"
      ],
      "to": "ReadyToConnect",
      "guard": "INT.stable_timer > PAR.stable_time",
      "priority": 4
    },
    {
      "name": "out_of_range",
      "from": [
        "ReadyToConnect"
      ],
      "to": "Running",
      "guard": "NOT (INT.v_ok AND INT.f_ok)",
      "priority": 4
    },
    {
      "name": "unloaded_cooldown",
      "from": [
        "Unloading"
      ],
      "to": "CoolingDown",
      "guard": "INT.unloaded AND SET.cooldown_enabled AND NOT INT.fast_stop",
      "priority": 3
    },
    {
      "name": "unloaded_stop",
      "from": [
        "Unloading"
      ],
      "to": "StoppingEngine",
      "guard": "INT.fast_stop OR (INT.unloaded AND NOT SET.cooldown_enabled)",
      "priority": 4
    },
    {
      "name": "fast_stop",
      "from": [
        "CoolingDown"
      ],
      "to": "StoppingEngine",
      "guard": "INT.fast_stop",
      "priority": 3
    },
    {
      "name": "engine_stopped",
      "from": [
        "StoppingEngine"
      ],
      "to": "Stopped",
      "guard": "NOT INT.running",
      "priority": 2
    },
    {
      "name": "taken_over_locally",
      "from": [
        "Unloading",
        "CoolingDown",
        "StoppingEngine"
      ],
      "to": "Running",
      "guard": "NOT STS.remote_ok AND INT.running",
      "priority": 5
    }
  ],
  "always": [
    {
      "tag": "INT.running",
      "value": "FIN.running"
    },
    {
      "tag": "INT.ready",
      "value": "FIN.ready"
    },
    {
      "tag": "INT.in_auto",
      "value": "FIN.in_auto"
    },
    {
      "tag": "INT.shutdown_active",
      "value": "FIN.shutdown_active"
    },
    {
      "tag": "INT.reporting",
      "value": "GOOD(FIN.running) AND GOOD(FIN.ready) AND GOOD(FIN.in_auto) AND GOOD(FIN.shutdown_active)"
    },
    {
      "tag": "STS.remote_ok",
      "value": "INT.reporting AND STS.enabled AND INT.in_auto"
    },
    {
      "tag": "INT.v_ok",
      "value": "FIN.voltage >= SET.rated_voltage * (1 - PAR.voltage_tol_pct / 100) AND FIN.voltage <= SET.rated_voltage * (1 + PAR.voltage_tol_pct / 100)"
    },
    {
      "tag": "INT.f_ok",
      "value": "FIN.frequency >= SET.rated_frequency * (1 - PAR.frequency_tol_pct / 100) AND FIN.frequency <= SET.rated_frequency * (1 + PAR.frequency_tol_pct / 100)"
    },
    {
      "tag": "INT.unloaded",
      "value": "FIN.active_power < SET.rated_power * 0.01"
    },
    {
      "tag": "INT.running_timer",
      "value": "time(INT.running)"
    },
    {
      "tag": "INT.stable_timer",
      "value": "time(INT.running AND INT.v_ok AND INT.f_ok)"
    },
    {
      "tag": "INT.shutdown_latched",
      "value": "(INT.shutdown_latched AND NOT CMD.reset) OR INT.shutdown_active"
    },
    {
      "tag": "INT.fast_stop",
      "value": "(INT.fast_stop OR (STS.remote_ok AND LOK.trip)) AND (STS.state = Running OR STS.state = Unloading)"
    },
    {
      "tag": "OUT.start_request",
      "value": "STS.state = Starting AND STS.remote_ok"
    },
    {
      "tag": "OUT.stop_request",
      "value": "STS.state = StoppingEngine AND STS.remote_ok"
    },
    {
      "tag": "OUT.reset_request",
      "value": "CMD.reset AND INT.reporting"
    },
    {
      "tag": "STS.load_pct",
      "value": "FIN.active_power / MAX(SET.rated_power, 1) * 100"
    },
    {
      "tag": "STS.cooldown_remaining",
      "value": "SEL(STS.state = CoolingDown, 0, MAX(0, PAR.cooldown_time - STATE_TIME()))"
    }
  ],
  "alarms": [
    {
      "name": "EngineShutdown",
      "kind": "Reactive",
      "condition": "INT.shutdown_active",
      "severity": 30,
      "message": "Engine shutdown",
      "latched": true
    },
    {
      "name": "StoppedUnexpectedly",
      "kind": "NonReactive",
      "condition": "STS.remote_ok",
      "severity": 25,
      "message": "Stopped unexpectedly",
      "onTransition": "stopped_unexpectedly",
      "latched": true
    },
    {
      "name": "ControllerCommunicationLost",
      "kind": "NonReactive",
      "condition": "NOT INT.reporting",
      "severity": 25,
      "message": "Controller communication lost"
    },
    {
      "name": "ControllerCommonAlarm",
      "kind": "NonReactive",
      "condition": "FIN.common_alarm",
      "severity": 20,
      "message": "Controller common alarm"
    },
    {
      "name": "ControllerCommonWarning",
      "kind": "NonReactive",
      "condition": "FIN.common_warning",
      "severity": 10,
      "message": "Controller common warning"
    },
    {
      "name": "CoolantTempHigh",
      "kind": "NonReactive",
      "condition": "FIN.coolant_temp > PAR.coolant_temp_H",
      "severity": 10,
      "message": "Coolant temperature high"
    },
    {
      "name": "CoolantTempHighHigh",
      "kind": "NonReactive",
      "condition": "FIN.coolant_temp > PAR.coolant_temp_HH",
      "severity": 25,
      "message": "Coolant temperature high-high"
    },
    {
      "name": "LubeOilPressureLow",
      "kind": "NonReactive",
      "condition": "INT.running_timer > PAR.oil_pressure_delay AND FIN.lube_oil_pressure < PAR.lube_oil_pressure_L",
      "severity": 10,
      "message": "Lube oil pressure low"
    },
    {
      "name": "LubeOilPressureLowLow",
      "kind": "NonReactive",
      "condition": "INT.running_timer > PAR.oil_pressure_delay AND FIN.lube_oil_pressure < PAR.lube_oil_pressure_LL",
      "severity": 25,
      "message": "Lube oil pressure low-low"
    },
    {
      "name": "LubeOilTempHigh",
      "kind": "NonReactive",
      "condition": "FIN.lube_oil_temp > PAR.lube_oil_temp_H",
      "severity": 10,
      "message": "Lube oil temperature high"
    },
    {
      "name": "BatteryVoltageLow",
      "kind": "NonReactive",
      "condition": "FIN.battery_voltage < PAR.battery_voltage_L",
      "severity": 10,
      "message": "Battery voltage low"
    },
    {
      "name": "Overload",
      "kind": "NonReactive",
      "condition": "time(STS.load_pct > PAR.overload_pct) > PAR.overload_delay",
      "severity": 20,
      "message": "Overload"
    },
    {
      "name": "VoltageOutOfRange",
      "kind": "NonReactive",
      "condition": "INT.running_timer > PAR.stable_time AND NOT INT.v_ok",
      "severity": 15,
      "message": "Voltage out of range"
    },
    {
      "name": "FrequencyOutOfRange",
      "kind": "NonReactive",
      "condition": "INT.running_timer > PAR.stable_time AND NOT INT.f_ok",
      "severity": 15,
      "message": "Frequency out of range"
    },
    {
      "name": "NotInAuto",
      "kind": "NonReactive",
      "condition": "STS.enabled AND NOT INT.in_auto",
      "severity": 5,
      "message": "Controller not in auto"
    }
  ],
  "plant": [
    {
      "tag": "FIN.in_auto",
      "value": "TRUE"
    },
    {
      "tag": "FIN.shutdown_active",
      "value": "FALSE"
    },
    {
      "tag": "FIN.ready",
      "value": "NOT FIN.shutdown_active"
    },
    {
      "tag": "FIN.running",
      "value": "(time(OUT.start_request) > 3 OR FIN.running) AND NOT OUT.stop_request AND NOT FIN.shutdown_active"
    },
    {
      "tag": "FIN.frequency",
      "value": "SEL(FIN.running, 0, SET.rated_frequency)"
    },
    {
      "tag": "FIN.voltage",
      "value": "SEL(FIN.running, 0, SET.rated_voltage)"
    },
    {
      "tag": "FIN.active_power",
      "value": "0"
    },
    {
      "tag": "FIN.coolant_temp",
      "value": "SEL(FIN.running, 40, 80)"
    },
    {
      "tag": "FIN.lube_oil_temp",
      "value": "SEL(FIN.running, 40, 85)"
    },
    {
      "tag": "FIN.lube_oil_pressure",
      "value": "SEL(FIN.running, 0, 4.5)"
    },
    {
      "tag": "FIN.battery_voltage",
      "value": "26.4"
    }
  ],
  "commandInputs": {
    "rows": [
      {
        "name": "HMI",
        "source": "Hmi",
        "kind": "Pulse",
        "drives": "OnOff",
        "on": 1,
        "off": 1,
        "inAuto": "Ignore",
        "location": "Any",
        "commands": [
          "reset"
        ]
      }
    ],
    "level": false
  }
}
