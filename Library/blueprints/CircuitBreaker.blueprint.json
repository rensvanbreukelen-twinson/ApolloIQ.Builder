{
  "schema": "apolloiq.blueprint/1",
  "kind": "CM",
  "name": "CircuitBreaker",
  "version": "0.1.0",
  "description": "Generic breaker: generator, bus-tie, shore connection, feeders and consumers. Held or bistable (pulsed) coils.",
  "interfaces": [
    "Base",
    "Switchable",
    "Resettable",
    "Interlocks"
  ],
  "tags": [
    {
      "group": "FIN",
      "name": "feedback",
      "dataType": "Bool",
      "description": "Breaker closed (auxiliary contact)",
      "source": "LocalIO",
      "primary": true
    },
    {
      "group": "FIN",
      "name": "power_ok",
      "dataType": "Bool",
      "description": "Breaker control power OK",
      "source": "LocalIO",
      "primary": false
    },
    {
      "group": "FIN",
      "name": "tripped",
      "dataType": "Bool",
      "description": "Trip indication",
      "source": "LocalIO",
      "primary": false
    },
    {
      "group": "FIN",
      "name": "remote",
      "dataType": "Bool",
      "description": "Local/remote selector in remote",
      "source": "LocalIO",
      "primary": false
    },
    {
      "group": "OUT",
      "name": "coil_on",
      "dataType": "Bool",
      "description": "Closing coil",
      "primary": false
    },
    {
      "group": "OUT",
      "name": "coil_off",
      "dataType": "Bool",
      "description": "Opening (shunt) coil, bistable breakers only",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_close_time",
      "dataType": "Real",
      "description": "Close command to feedback true",
      "unit": "s",
      "min": 0.1,
      "max": 30,
      "initial": "1",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_open_time",
      "dataType": "Real",
      "description": "Open command to feedback false",
      "unit": "s",
      "min": 0.1,
      "max": 30,
      "initial": "1",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "pulse_time",
      "dataType": "Real",
      "description": "Coil pulse length (bistable)",
      "unit": "s",
      "min": 0.1,
      "max": 5,
      "initial": "0.5",
      "primary": false
    },
    {
      "group": "SET",
      "name": "invert_output",
      "dataType": "Bool",
      "description": "Invert both coil outputs",
      "initial": "FALSE",
      "primary": false
    },
    {
      "group": "SET",
      "name": "bistable",
      "dataType": "Bool",
      "description": "Coils are pulsed instead of held",
      "initial": "FALSE",
      "primary": false
    },
    {
      "group": "SET",
      "name": "trip_latches",
      "dataType": "Bool",
      "description": "After a trip, CMD.reset is required before closing again",
      "initial": "TRUE",
      "primary": false
    },
    {
      "group": "INT",
      "name": "feedback",
      "dataType": "Bool",
      "description": "Conditioned feedback",
      "primary": false
    },
    {
      "group": "INT",
      "name": "power_ok",
      "dataType": "Bool",
      "description": "Conditioned control power",
      "primary": false
    },
    {
      "group": "INT",
      "name": "tripped",
      "dataType": "Bool",
      "description": "Conditioned trip indication",
      "primary": false
    },
    {
      "group": "INT",
      "name": "remote",
      "dataType": "Bool",
      "description": "Conditioned remote selector",
      "primary": false
    },
    {
      "group": "INT",
      "name": "trip_latched",
      "dataType": "Bool",
      "description": "Set by a trip, cleared by CMD.reset",
      "primary": false
    }
  ],
  "roles": [],
  "states": [
    {
      "name": "OpenNotReady",
      "category": 0,
      "code": 0,
      "initial": true,
      "entry": [],
      "run": [
        {
          "tag": "OUT.coil_on",
          "value": "SET.invert_output"
        },
        {
          "tag": "OUT.coil_off",
          "value": "SET.invert_output"
        }
      ],
      "exit": []
    },
    {
      "name": "Open",
      "category": 200,
      "code": 200,
      "initial": false,
      "entry": [],
      "run": [
        {
          "tag": "OUT.coil_on",
          "value": "SET.invert_output"
        },
        {
          "tag": "OUT.coil_off",
          "value": "SET.invert_output"
        }
      ],
      "exit": []
    },
    {
      "name": "Closing",
      "category": 300,
      "code": 300,
      "initial": false,
      "entry": [],
      "run": [
        {
          "tag": "OUT.coil_on",
          "value": "SEL(SET.bistable, TRUE, STATE_TIME() < PAR.pulse_time) XOR SET.invert_output"
        },
        {
          "tag": "OUT.coil_off",
          "value": "SET.invert_output"
        }
      ],
      "exit": [],
      "timeout": {
        "time": "PAR.max_close_time",
        "goTo": "OpenNotReady",
        "alarm": "NotClosing",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "Closed",
      "category": 400,
      "code": 400,
      "initial": false,
      "entry": [],
      "run": [
        {
          "tag": "OUT.coil_on",
          "value": "(NOT SET.bistable) XOR SET.invert_output"
        },
        {
          "tag": "OUT.coil_off",
          "value": "SET.invert_output"
        }
      ],
      "exit": []
    },
    {
      "name": "Opening",
      "category": 100,
      "code": 100,
      "initial": false,
      "entry": [],
      "run": [
        {
          "tag": "OUT.coil_on",
          "value": "SET.invert_output"
        },
        {
          "tag": "OUT.coil_off",
          "value": "SEL(SET.bistable, FALSE, STATE_TIME() < PAR.pulse_time) XOR SET.invert_output"
        }
      ],
      "exit": [],
      "timeout": {
        "time": "PAR.max_open_time",
        "alarm": "NotOpening",
        "alarmKind": "NonReactive",
        "severity": 25
      }
    },
    {
      "name": "Tripped",
      "category": 500,
      "code": 500,
      "initial": false,
      "entry": [],
      "run": [
        {
          "tag": "OUT.coil_on",
          "value": "SET.invert_output"
        },
        {
          "tag": "OUT.coil_off",
          "value": "SET.invert_output"
        }
      ],
      "exit": []
    }
  ],
  "transitions": [
    {
      "name": "tripped",
      "from": [
        "Closing",
        "Closed",
        "Opening"
      ],
      "to": "Tripped",
      "guard": "INT.tripped",
      "priority": 1
    },
    {
      "name": "reset",
      "from": [
        "Tripped"
      ],
      "to": "OpenNotReady",
      "guard": "NOT INT.tripped AND NOT INT.trip_latched",
      "priority": 1
    },
    {
      "name": "closed_locally",
      "from": [
        "OpenNotReady",
        "Open"
      ],
      "to": "Closed",
      "guard": "INT.feedback",
      "priority": 2
    },
    {
      "name": "ready",
      "from": [
        "OpenNotReady"
      ],
      "to": "Open",
      "guard": "NOT INT.trip_latched",
      "priority": 3
    },
    {
      "name": "not_ready",
      "from": [
        "Open"
      ],
      "to": "OpenNotReady",
      "guard": "INT.trip_latched",
      "priority": 3
    },
    {
      "name": "close",
      "from": [
        "Open"
      ],
      "to": "Closing",
      "guard": "STS.remote_ok AND LOK.can_on AND CMD.set_on",
      "priority": 4
    },
    {
      "name": "closed",
      "from": [
        "Closing"
      ],
      "to": "Closed",
      "guard": "INT.feedback",
      "priority": 2
    },
    {
      "name": "close_aborted",
      "from": [
        "Closing"
      ],
      "to": "OpenNotReady",
      "guard": "NOT STS.remote_ok OR CMD.set_off",
      "priority": 4
    },
    {
      "name": "open",
      "from": [
        "Closed"
      ],
      "to": "Opening",
      "guard": "STS.remote_ok AND ((CMD.set_off AND LOK.can_off) OR LOK.trip)",
      "priority": 2
    },
    {
      "name": "opened_unexpectedly",
      "from": [
        "Closed"
      ],
      "to": "OpenNotReady",
      "guard": "NOT INT.feedback",
      "priority": 3
    },
    {
      "name": "opened",
      "from": [
        "Opening"
      ],
      "to": "OpenNotReady",
      "guard": "NOT INT.feedback",
      "priority": 2
    },
    {
      "name": "taken_over_locally",
      "from": [
        "Opening"
      ],
      "to": "Closed",
      "guard": "NOT STS.remote_ok AND INT.feedback",
      "priority": 3
    }
  ],
  "always": [
    {
      "tag": "INT.feedback",
      "value": "FIN.feedback"
    },
    {
      "tag": "INT.power_ok",
      "value": "FIN.power_ok"
    },
    {
      "tag": "INT.tripped",
      "value": "FIN.tripped"
    },
    {
      "tag": "INT.remote",
      "value": "FIN.remote"
    },
    {
      "tag": "STS.remote_ok",
      "value": "STS.enabled AND INT.remote AND INT.power_ok AND GOOD(FIN.feedback)"
    },
    {
      "tag": "INT.trip_latched",
      "value": "(INT.trip_latched AND NOT CMD.reset) OR (INT.tripped AND SET.trip_latches)"
    }
  ],
  "alarms": [
    {
      "name": "Tripped",
      "kind": "Reactive",
      "condition": "INT.tripped OR INT.trip_latched",
      "severity": 25,
      "message": "Tripped",
      "latched": false
    },
    {
      "name": "OpenedUnexpectedly",
      "kind": "NonReactive",
      "condition": "STS.remote_ok",
      "severity": 20,
      "message": "Opened unexpectedly",
      "onTransition": "opened_unexpectedly",
      "latched": true
    },
    {
      "name": "ClosedUnexpectedly",
      "kind": "NonReactive",
      "condition": "STS.remote_ok",
      "severity": 20,
      "message": "Closed unexpectedly",
      "onTransition": "closed_locally",
      "latched": true
    },
    {
      "name": "ControlPowerFailure",
      "kind": "NonReactive",
      "condition": "NOT INT.power_ok",
      "severity": 20,
      "message": "Control power failure"
    },
    {
      "name": "InLocal",
      "kind": "NonReactive",
      "condition": "NOT INT.remote",
      "severity": 5,
      "message": "In local"
    }
  ],
  "plant": [
    {
      "tag": "FIN.power_ok",
      "value": "TRUE"
    },
    {
      "tag": "FIN.remote",
      "value": "TRUE"
    },
    {
      "tag": "FIN.tripped",
      "value": "FALSE"
    },
    {
      "tag": "FIN.feedback",
      "value": "SEL(SET.bistable, OUT.coil_on XOR SET.invert_output, ((OUT.coil_on XOR SET.invert_output) OR FIN.feedback) AND NOT (OUT.coil_off XOR SET.invert_output))"
    }
  ],
  "aliases": {
    "is_closed": "is_running",
    "is_open": "is_off"
  },
  "commandInputs": {
    "rows": [
      {
        "name": "HMI",
        "source": "Hmi",
        "kind": "Pulse",
        "drives": "OnOff",
        "on": 1,
        "off": 1,
        "inAuto": "Ignore",
        "location": "Any",
        "commands": [
          "reset"
        ]
      }
    ],
    "level": false
  }
}
