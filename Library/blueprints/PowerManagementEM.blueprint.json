{
  "schema": "apolloiq.blueprint/1",
  "kind": "Unit",
  "name": "PowerManagementEM",
  "version": "0.1.0",
  "description": "PMS built on Equipment modules (4.11): two GenSetPowerSource EMs and a shore breaker. The EMs start, synchronise, connect and stop their generator; the Unit only chooses the source: blackout protection, switchover, shore power, start from blackout.",
  "interfaces": [
    "Base",
    "AutoManual",
    "Resettable"
  ],
  "tags": [
    {
      "group": "FIN",
      "name": "shore_available",
      "dataType": "Bool",
      "description": "Shore power available",
      "source": "LocalIO",
      "primary": false
    },
    {
      "group": "CMD",
      "name": "select_gen1",
      "dataType": "Bool",
      "description": "Use GenSet 1",
      "primary": false
    },
    {
      "group": "CMD",
      "name": "select_gen2",
      "dataType": "Bool",
      "description": "Use GenSet 2",
      "primary": false
    },
    {
      "group": "SET",
      "name": "blackout_protection",
      "dataType": "Bool",
      "description": "Start the other generator when the running one is lost",
      "initial": "TRUE",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_start_time",
      "dataType": "Real",
      "description": "Start command to generator on the bus",
      "unit": "s",
      "initial": "90",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_handover_time",
      "dataType": "Real",
      "description": "Stop command to generator off the bus",
      "unit": "s",
      "initial": "90",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "max_close_time",
      "dataType": "Real",
      "description": "Shore breaker close time",
      "unit": "s",
      "initial": "5",
      "primary": false
    },
    {
      "group": "PAR",
      "name": "shore_delay",
      "dataType": "Real",
      "description": "Dead time before the shore breaker closes",
      "unit": "s",
      "initial": "3",
      "primary": false
    },
    {
      "group": "STS",
      "name": "available_kw",
      "dataType": "Real",
      "description": "Spare power on the bus",
      "unit": "kW",
      "primary": true
    },
    {
      "group": "STS",
      "name": "bus_dead",
      "dataType": "Bool",
      "description": "No generator or shore breaker is closed"
    }
  ],
  "roles": [
    {
      "name": "GEN1",
      "blueprint": "GenSetPowerSource"
    },
    {
      "name": "GEN2",
      "blueprint": "GenSetPowerSource"
    },
    {
      "name": "SHORE_CB",
      "blueprint": "CircuitBreaker"
    }
  ],
  "states": [
    {
      "name": "Blackout",
      "category": 0,
      "code": 0,
      "initial": true,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "StartGEN1",
      "category": 300,
      "code": 300,
      "initial": false,
      "entry": [
        {
          "tag": "GEN1.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_start_time",
        "goTo": "Blackout",
        "alarm": "Gen1StartFailed",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "OnGEN1",
      "category": 400,
      "code": 400,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "SwitchToGEN1",
      "category": 300,
      "code": 300,
      "initial": false,
      "entry": [
        {
          "tag": "GEN1.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_start_time",
        "goTo": "OnGEN2",
        "alarm": "SwitchToGen1Failed",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "HandoverToGEN1",
      "category": 400,
      "code": 400,
      "initial": false,
      "entry": [
        {
          "tag": "GEN2.CMD.set_off",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_handover_time",
        "goTo": "OnGEN1",
        "alarm": "Gen2NotDisconnected",
        "alarmKind": "Reactive",
        "severity": 15
      }
    },
    {
      "name": "StartGEN2",
      "category": 300,
      "code": 300,
      "initial": false,
      "entry": [
        {
          "tag": "GEN2.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_start_time",
        "goTo": "Blackout",
        "alarm": "Gen2StartFailed",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "OnGEN2",
      "category": 400,
      "code": 400,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": []
    },
    {
      "name": "SwitchToGEN2",
      "category": 300,
      "code": 300,
      "initial": false,
      "entry": [
        {
          "tag": "GEN2.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_start_time",
        "goTo": "OnGEN1",
        "alarm": "SwitchToGen2Failed",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "HandoverToGEN2",
      "category": 400,
      "code": 400,
      "initial": false,
      "entry": [
        {
          "tag": "GEN1.CMD.set_off",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_handover_time",
        "goTo": "OnGEN2",
        "alarm": "Gen1NotDisconnected",
        "alarmKind": "Reactive",
        "severity": 15
      }
    },
    {
      "name": "ToShore",
      "category": 100,
      "code": 100,
      "initial": false,
      "entry": [
        {
          "tag": "GEN1.CMD.set_off",
          "value": "TRUE"
        },
        {
          "tag": "GEN2.CMD.set_off",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_handover_time",
        "goTo": "Blackout",
        "alarm": "GeneratorsNotDisconnected",
        "alarmKind": "Reactive",
        "severity": 20
      }
    },
    {
      "name": "ShoreDelay",
      "category": 100,
      "code": 100,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.shore_delay",
        "goTo": "CloseShore",
        "alarmKind": "NonReactive",
        "severity": 20
      }
    },
    {
      "name": "CloseShore",
      "category": 300,
      "code": 300,
      "initial": false,
      "entry": [
        {
          "tag": "SHORE_CB.CMD.set_on",
          "value": "TRUE"
        }
      ],
      "run": [],
      "exit": [],
      "timeout": {
        "time": "PAR.max_close_time",
        "goTo": "Blackout",
        "alarm": "ShoreBreakerNotClosing",
        "alarmKind": "Reactive",
        "severity": 25
      }
    },
    {
      "name": "OnShore",
      "category": 400,
      "code": 400,
      "initial": false,
      "entry": [],
      "run": [],
      "exit": []
    }
  ],
  "transitions": [
    {
      "name": "select_gen1_from_blackout",
      "from": [
        "Blackout"
      ],
      "to": "StartGEN1",
      "guard": "CMD.select_gen1",
      "priority": 10
    },
    {
      "name": "gen1_on_bus",
      "from": [
        "StartGEN1"
      ],
      "to": "OnGEN1",
      "guard": "GEN1.STS.state = Running",
      "priority": 10
    },
    {
      "name": "switch_to_gen1",
      "from": [
        "OnGEN2"
      ],
      "to": "SwitchToGEN1",
      "guard": "CMD.select_gen1",
      "priority": 10
    },
    {
      "name": "gen1_paralleled",
      "from": [
        "SwitchToGEN1"
      ],
      "to": "HandoverToGEN1",
      "guard": "GEN1.STS.state = Running",
      "priority": 10
    },
    {
      "name": "gen2_disconnected",
      "from": [
        "HandoverToGEN1"
      ],
      "to": "OnGEN1",
      "guard": "NOT (GEN2.STS.state = Running OR GEN2.STS.state = Unloading)",
      "priority": 10
    },
    {
      "name": "gen1_lost_protected",
      "from": [
        "OnGEN1"
      ],
      "to": "StartGEN2",
      "guard": "SET.blackout_protection AND STS.auto AND NOT (GEN1.STS.state = Running)",
      "priority": 5
    },
    {
      "name": "gen1_lost",
      "from": [
        "OnGEN1"
      ],
      "to": "Blackout",
      "guard": "NOT (GEN1.STS.state = Running)",
      "priority": 6
    },
    {
      "name": "shore_plugged_in_gen1",
      "from": [
        "OnGEN1"
      ],
      "to": "ToShore",
      "guard": "FIN.shore_available AND STS.auto",
      "priority": 10
    },
    {
      "name": "select_gen2_from_blackout",
      "from": [
        "Blackout"
      ],
      "to": "StartGEN2",
      "guard": "CMD.select_gen2",
      "priority": 10
    },
    {
      "name": "gen2_on_bus",
      "from": [
        "StartGEN2"
      ],
      "to": "OnGEN2",
      "guard": "GEN2.STS.state = Running",
      "priority": 10
    },
    {
      "name": "switch_to_gen2",
      "from": [
        "OnGEN1"
      ],
      "to": "SwitchToGEN2",
      "guard": "CMD.select_gen2",
      "priority": 10
    },
    {
      "name": "gen2_paralleled",
      "from": [
        "SwitchToGEN2"
      ],
      "to": "HandoverToGEN2",
      "guard": "GEN2.STS.state = Running",
      "priority": 10
    },
    {
      "name": "gen1_disconnected",
      "from": [
        "HandoverToGEN2"
      ],
      "to": "OnGEN2",
      "guard": "NOT (GEN1.STS.state = Running OR GEN1.STS.state = Unloading)",
      "priority": 10
    },
    {
      "name": "gen2_lost_protected",
      "from": [
        "OnGEN2"
      ],
      "to": "StartGEN1",
      "guard": "SET.blackout_protection AND STS.auto AND NOT (GEN2.STS.state = Running)",
      "priority": 5
    },
    {
      "name": "gen2_lost",
      "from": [
        "OnGEN2"
      ],
      "to": "Blackout",
      "guard": "NOT (GEN2.STS.state = Running)",
      "priority": 6
    },
    {
      "name": "shore_plugged_in_gen2",
      "from": [
        "OnGEN2"
      ],
      "to": "ToShore",
      "guard": "FIN.shore_available AND STS.auto",
      "priority": 10
    },
    {
      "name": "generators_off_bus",
      "from": [
        "ToShore"
      ],
      "to": "ShoreDelay",
      "guard": "NOT GEN1.STS.on_bus AND NOT GEN2.STS.on_bus",
      "priority": 10
    },
    {
      "name": "shore_from_blackout",
      "from": [
        "Blackout"
      ],
      "to": "CloseShore",
      "guard": "FIN.shore_available AND STS.auto",
      "priority": 10
    },
    {
      "name": "shore_connected",
      "from": [
        "CloseShore"
      ],
      "to": "OnShore",
      "guard": "SHORE_CB.STS.state = Closed",
      "priority": 10
    },
    {
      "name": "shore_lost_protected",
      "from": [
        "OnShore"
      ],
      "to": "StartGEN1",
      "guard": "SET.blackout_protection AND STS.auto AND NOT (SHORE_CB.STS.state = Closed)",
      "priority": 5
    },
    {
      "name": "shore_lost",
      "from": [
        "OnShore"
      ],
      "to": "Blackout",
      "guard": "NOT (SHORE_CB.STS.state = Closed)",
      "priority": 6
    },
    {
      "name": "shore_unplugged",
      "from": [
        "ShoreDelay",
        "CloseShore"
      ],
      "to": "Blackout",
      "guard": "NOT FIN.shore_available",
      "priority": 10
    }
  ],
  "always": [
    {
      "tag": "STS.remote_ok",
      "value": "STS.enabled"
    },
    {
      "tag": "STS.available_kw",
      "value": "GEN1.STS.available_kw + GEN2.STS.available_kw"
    },
    {
      "tag": "STS.bus_dead",
      "value": "NOT GEN1.BREAKER.is_closed AND NOT GEN2.BREAKER.is_closed AND NOT SHORE_CB.is_closed"
    }
  ],
  "alarms": [],
  "plant": [],
  "commandInputs": {
    "rows": [
      {
        "name": "HMI",
        "source": "Hmi",
        "kind": "Pulse",
        "drives": "OnOff",
        "on": null,
        "off": null,
        "inAuto": "Always",
        "location": "Any",
        "commands": [
          "select_gen1",
          "select_gen2",
          "set_auto",
          "set_manual",
          "reset"
        ]
      }
    ],
    "level": false
  },
  "interlocks": [
    {
      "target": "GEN1.BREAKER",
      "kind": "SwitchOn",
      "condition": "STS.bus_dead OR GEN1.FIN.sync_ok",
      "text": "Bus dead or GEN1 in sync"
    },
    {
      "target": "GEN1.BREAKER",
      "kind": "SwitchOn",
      "condition": "NOT SHORE_CB.is_closed",
      "text": "Shore power not connected"
    },
    {
      "target": "GEN2.BREAKER",
      "kind": "SwitchOn",
      "condition": "STS.bus_dead OR GEN2.FIN.sync_ok",
      "text": "Bus dead or GEN2 in sync"
    },
    {
      "target": "GEN2.BREAKER",
      "kind": "SwitchOn",
      "condition": "NOT SHORE_CB.is_closed",
      "text": "Shore power not connected"
    },
    {
      "target": "SHORE_CB",
      "kind": "SwitchOn",
      "condition": "NOT GEN1.BREAKER.is_closed AND NOT GEN2.BREAKER.is_closed",
      "text": "Generator breakers open"
    }
  ]
}
