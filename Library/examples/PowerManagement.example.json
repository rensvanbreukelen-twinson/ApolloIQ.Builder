{
  "schema": "apolloiq.example/1",
  "name": "Power management",
  "description": "The PMS Unit on two GenSet Power Source equipment modules (GenSet + breaker + power meter each) and a shore breaker (4.11). Interlocks (4.5, G-172): the GenSetPowerSource blueprint lets a breaker close only with its engine running and trips it when the engine stops (escalate EM); the PowerManagementEM blueprint adds 'bus dead or in sync' and 'shore not connected' to the generator breakers and 'generator breakers open' to the shore breaker. This project adds two lines of its own on PMS for SHORE_CB: close only with shore power available, and trip when it is lost. The EMs have no HMI On/Off of their own: PMS starts and stops them; the HMI can only reset them.",
  "folders": [],
  "units": [
    {
      "folder": "",
      "name": "PMS",
      "blueprint": "PowerManagementEM",
      "members": {
        "GEN1": "PMS.GEN1_PS",
        "GEN2": "PMS.GEN2_PS",
        "SHORE_CB": "PMS.SHORE_CB"
      }
    },
    {
      "folder": "PMS",
      "name": "GEN1_PS",
      "blueprint": "GenSetPowerSource",
      "members": {
        "ENGINE": "PMS.GEN1_PS.GEN1",
        "BREAKER": "PMS.GEN1_PS.GEN1_CB",
        "METER": "PMS.GEN1_PS.GEN1_PM"
      },
      "hmi": { "name": "HMI", "source": "Hmi", "kind": "Pulse", "drives": "OnOff", "inAuto": "Ignore", "commands": ["reset"] }
    },
    {
      "folder": "PMS",
      "name": "GEN2_PS",
      "blueprint": "GenSetPowerSource",
      "members": {
        "ENGINE": "PMS.GEN2_PS.GEN2",
        "BREAKER": "PMS.GEN2_PS.GEN2_CB",
        "METER": "PMS.GEN2_PS.GEN2_PM"
      },
      "hmi": { "name": "HMI", "source": "Hmi", "kind": "Pulse", "drives": "OnOff", "inAuto": "Ignore", "commands": ["reset"] }
    }
  ],
  "controlModules": [
    {
      "folder": "PMS.GEN1_PS",
      "name": "GEN1",
      "blueprint": "GenSet"
    },
    {
      "folder": "PMS.GEN1_PS",
      "name": "GEN1_CB",
      "blueprint": "CircuitBreaker"
    },
    {
      "folder": "PMS.GEN1_PS",
      "name": "GEN1_PM",
      "blueprint": "PowerMeter"
    },
    {
      "folder": "PMS.GEN2_PS",
      "name": "GEN2",
      "blueprint": "GenSet"
    },
    {
      "folder": "PMS.GEN2_PS",
      "name": "GEN2_CB",
      "blueprint": "CircuitBreaker"
    },
    {
      "folder": "PMS.GEN2_PS",
      "name": "GEN2_PM",
      "blueprint": "PowerMeter"
    },
    {
      "folder": "PMS",
      "name": "SHORE_CB",
      "blueprint": "CircuitBreaker"
    }
  ],
  "interlocks": [
    {
      "owner": "PMS",
      "target": "PMS.SHORE_CB",
      "kind": "SwitchOn",
      "condition": "[PMS.FIN.shore_available]",
      "text": "Shore power available"
    },
    {
      "owner": "PMS",
      "target": "PMS.SHORE_CB",
      "kind": "Trip",
      "condition": "NOT [PMS.FIN.shore_available]",
      "text": "Shore breaker opened: shore power lost",
      "alarm": "ShorePowerLost",
      "severity": 20,
      "escalate": "None"
    }
  ],
  "layout": []
}
