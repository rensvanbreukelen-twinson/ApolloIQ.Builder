        },
        {
          "set": {
            "PAR.max_sync_time": 3
          }
        },
        {
          "force": {
            "FIN.sync_ok": false
          }
        },
        {
          "set": {
            "CMD.HMI_on": true
          }
        },
        {
          "until": "STS.state = Connecting",
          "within": "15 s"
        },
        {
          "until": "STS.state = Shutdown",
          "within": "5 s"
        },
        {
          "run": 1
        },
        {
          "expect": [
            "ALM.FailedToConnect.active",
            "CB: STS.state = Open",
            "NOT OUT.sync_request"
          ]
        }
      ]
    },
