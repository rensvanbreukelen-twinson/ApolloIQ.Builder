{
  "schema": "apolloiq.scenarios/1",
  "type": "GenSetPowerSource",
  "scenarios": [
    {
      "name": "Start, synchronise, close, carry load and stop again",
      "instances": [
        {
          "name": "PS",
          "type": "GenSetPowerSource"
        },
        {
          "name": "GEN",
          "type": "GenSet",
          "parent": "PS"
        },
        {
          "name": "CB",
          "type": "CircuitBreaker",
          "parent": "PS"
        },
        {
          "name": "PM",
          "type": "PowerMeter",
          "parent": "PS"
        }
      ],
      "steps": [
        {
          "run": 5
        },
        {
          "expect": "STS.state = Available"
        },
        {
          "set": {
            "CMD.set_auto": true,
            "GEN.PAR.cooldown_time": 2
          }
        },
        {
          "run": 3
        },
        {
          "expect": "STS.auto"
        },
        {
          "set": {
            "CMD.HMI_on": true
          }
        },
        {
          "until": "STS.state = Starting",
          "within": "0.5 s"
        },
        {
          "expect": "GEN: STS.state = Starting"
        },
        {
          "until": "STS.state = Connecting",
          "within": "15 s"
        },
        {
          "run": 2
        },
        {
          "expect": [
            "OUT.sync_request",
            "CB: STS.state = Open"
          ]
        },
        {
          "until": "STS.state = Running",
          "within": "5 s"
        },
        {
          "run": 1
        },
        {
          "expect": [
            "CB: STS.state = Closed",
            "STS.on_bus",
            "NOT OUT.sync_request"
          ]
        },
        {
          "force": {
            "PM.FIN.active_power": 300
          }
        },
        {
          "run": 2
        },
        {
          "expect": [
            "STS.active_power = 300",
            "STS.available_kw = 200",
            "PM: STS.load_pct = 60"
          ]
        },
        {
          "set": {
            "CMD.HMI_off": true
          }
        },
        {
          "until": "STS.state = Unloading",
          "within": "0.5 s"
        },
        {
          "run": 20
        },
        {
          "expect": [
            "STS.state = Unloading",
            "CB: STS.state = Closed"
          ]
        },
        {
          "force": {
            "PM.FIN.active_power": 10
          }
        },
        {
          "until": "STS.state = StoppingEngine",
          "within": "2 s"
        },
        {
          "expect": "CB: STS.state <> Closed"
        },
        {
          "until": "STS.state = Stopped OR STS.state = Available",
          "within": "15 s"
        },
        {
          "until": "STS.state = Available",
          "within": "2 s"
        },
        {
          "expect": "NOT STS.on_bus"
        }
      ]
    },
    {
      "name": "A breaker trip gives Shutdown; one reset brings it back",
      "instances": [
        {
          "name": "PS",
          "type": "GenSetPowerSource"
        },
        {
          "name": "GEN",
          "type": "GenSet",
          "parent": "PS"
        },
        {
          "name": "CB",
          "type": "CircuitBreaker",
          "parent": "PS"
        },
        {
          "name": "PM",
          "type": "PowerMeter",
          "parent": "PS"
        }
      ],
      "steps": [
        {
          "run": 5
        },
        {
          "expect": "STS.state = Available"
        },
        {
          "set": {
            "CMD.set_auto": true,
            "GEN.PAR.cooldown_time": 2
          }
        },
        {
          "run": 3
        },
        {
          "expect": "STS.auto"
        },
        {
          "set": {
            "CMD.HMI_on": true
          }
        },
        {
          "until": "STS.state = Starting",
          "within": "0.5 s"
        },
        {
          "expect": "GEN: STS.state = Starting"
        },
        {
          "until": "STS.state = Connecting",
          "within": "15 s"
        },
        {
          "run": 2
        },
        {
          "expect": [
            "OUT.sync_request",
            "CB: STS.state = Open"
          ]
        },
        {
          "until": "STS.state = Running",
          "within": "5 s"
        },
        {
          "run": 1
        },
        {
          "expect": [
            "CB: STS.state = Closed",
            "STS.on_bus",
            "NOT OUT.sync_request"
          ]
        },
        {
          "force": {
            "CB.FIN.tripped": true
          }
        },
        {
          "until": "STS.state = Shutdown",
          "within": "0.5 s"
        },
        {
          "run": 1
        },
        {
          "expect": "CB: STS.state = Tripped"
        },
        {
          "release": [
            "CB.FIN.tripped"
          ]
        },
        {
          "run": 3
        },
        {
          "expect": "STS.state = Shutdown"
        },
        {
          "set": {
            "CMD.HMI_reset": true
          }
        },
        {
          "until": "STS.state = Stopped OR STS.state = Available",
          "within": "1 s"
        },
        {
          "expect": "CB: STS.state <> Tripped"
        }
      ]
    },
    {
      "name": "No sync OK: the breaker is never closed and the EM gives FailedToConnect",
      "instances": [
        {
          "name": "PS",
