    {
      "name": "Interlock trip: the breaker opens as soon as the engine stops, the EM escalates to Shutdown, one reset clears it",
      "instances": [
        {
          "name": "PS",
          "type": "GenSetPowerSource"
        },
        {
          "name": "GEN",
          "type": "GenSet",
          "parent": "PS"
        },
        {
          "name": "CB",
          "type": "CircuitBreaker",
          "parent": "PS"
        },
        {
          "name": "PM",
          "type": "PowerMeter",
          "parent": "PS"
        }
      ],
      "steps": [
        {
          "run": 5
        },
        {
          "expect": "STS.state = Available"
        },
        {
          "set": {
            "CMD.set_auto": true,
            "GEN.PAR.cooldown_time": 2
          }
        },
        {
          "run": 3
        },
        {
          "expect": "STS.auto"
        },
        {
          "set": {
            "CMD.HMI_on": true
          }
        },
        {
          "until": "STS.state = Starting",
          "within": "0.5 s"
        },
        {
          "expect": "GEN: STS.state = Starting"
        },
        {
          "until": "STS.state = Connecting",
          "within": "15 s"
        },
        {
          "run": 2
        },
        {
          "expect": [
            "OUT.sync_request",
            "CB: STS.state = Open"
          ]
        },
        {
          "until": "STS.state = Running",
          "within": "5 s"
        },
        {
          "run": 1
        },
        {
          "expect": [
            "CB: STS.state = Closed",
            "STS.on_bus",
            "NOT OUT.sync_request"
          ]
        },
        {
          "expect": [
            "CB: LOK.can_on",
            "CB: LOK.can_on_status = 1",
            "CB: NOT LOK.trip"
          ]
        },
        {
          "force": {
            "GEN.FIN.running": false
          }
        },
        {
          "until": "CB: STS.state <> Closed",
          "within": "0.2 s"
        },
        {
          "run": 1
        },
        {
          "expect": [
            "CB: LOK.trip",
            "ALM.EngineNotRunning.active",
            "CB: NOT LOK.can_on",
            "INT.member_tripped"
          ]
        },
        {
          "until": "STS.state = Shutdown",
          "within": "0.2 s"
        },
        {
          "expect": "INT.escalated"
        },
        {
          "release": [
            "GEN.FIN.running"
          ]
        },
        {
          "run": 5
        },
        {
          "expect": [
            "STS.state = Shutdown",
            "ALM.EngineNotRunning.active"
          ]
        },
        {
          "set": {
            "CMD.HMI_reset": true
          }
        },
        {
          "run": 2
        },
        {
          "expect": [
            "NOT ALM.EngineNotRunning.active",
            "CB: NOT LOK.trip",
            "NOT INT.escalated"
          ]
        },
        {
          "until": "STS.state <> Shutdown",
          "within": "1 s"
        }
      ]
    },
