          "name": "CB",
          "type": "CircuitBreaker",
          "parent": "PS"
        },
        {
          "name": "PM",
          "type": "PowerMeter",
          "parent": "PS"
        }
      ],
      "steps": [
        {
          "run": 5
        },
        {
          "expect": [
            "STS.state = Available",
            "NOT STS.auto"
          ]
        },
