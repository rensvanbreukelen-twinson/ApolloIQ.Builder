{
  "schema": "apolloiq.cmtype/1",
  "name": "GenSet",
  "version": "1.3.0",
  "description": "Diesel engine plus generator with an external genset controller",
  "enums": {
    "Frequency": [
      { "name": "Hz50", "value": 50 },
      { "name": "Hz60", "value": 60 }
    ]
  },
  "states": [
    { "code": 101, "name": "CoolingDown", "description": "Breaker open, running unloaded for PAR.cooldown_time" },
    { "code": 401, "name": "ReadyToConnect", "description": "Running, voltage and frequency within tolerance for PAR.stable_time" }
  ],
  "tags": {
    "FIN": [
      { "name": "running", "type": "Bool", "source": "controller", "description": "Engine running" },
      { "name": "ready", "type": "Bool", "source": "controller", "description": "Ready to start: no shutdown or start block in the controller" },
      { "name": "in_auto", "type": "Bool", "source": "controller", "description": "Controller in auto" },
      { "name": "shutdown_active", "type": "Bool", "source": "controller", "description": "Engine protection shutdown active" },
      { "name": "common_alarm", "type": "Bool", "source": "controller", "description": "Controller common alarm" },
      { "name": "common_warning", "type": "Bool", "source": "controller", "description": "Controller common warning" },
      { "name": "speed", "type": "Real", "unit": "rpm", "source": "controller", "description": "Engine speed" },
      { "name": "frequency", "type": "Real", "unit": "Hz", "source": "controller", "description": "Generator frequency" },
      { "name": "voltage", "type": "Real", "unit": "V", "source": "controller", "description": "Generator voltage (L-L)" },
      { "name": "current", "type": "Real", "unit": "A", "source": "controller", "description": "Generator current (highest phase)" },
      { "name": "active_power", "type": "Real", "unit": "kW", "source": "controller", "description": "Output power" },
      { "name": "reactive_power", "type": "Real", "unit": "kVAr", "source": "controller", "description": "Reactive power" },
      { "name": "power_factor", "type": "Real", "source": "controller", "description": "cos phi" },
      { "name": "coolant_temp", "type": "Real", "unit": "°C", "source": "controller", "description": "Coolant temperature" },
      { "name": "lube_oil_pressure", "type": "Real", "unit": "bar", "source": "controller", "description": "Lube oil pressure" },
      { "name": "lube_oil_temp", "type": "Real", "unit": "°C", "source": "controller", "description": "Lube oil temperature" },
      { "name": "exhaust_temp", "type": "Real", "unit": "°C", "source": "controller", "optional": true, "description": "Exhaust temperature" },
      { "name": "battery_voltage", "type": "Real", "unit": "V", "source": "controller", "description": "Starting battery voltage" },
      { "name": "controller_hours", "type": "Real", "unit": "h", "source": "controller", "optional": true, "description": "Running hours counted by the controller" }
    ],
    "CMD": [
      { "name": "set_on", "type": "Bool", "description": "Start" },
      { "name": "set_off", "type": "Bool", "description": "Stop: breaker opens, then cooldown, then stop" },
      { "name": "reset", "type": "Bool", "description": "Reset latched alarms and forward a reset to the controller" },
      { "name": "set_auto", "type": "Bool", "optional": true, "description": "Switch the controller to auto" },
      { "name": "set_manual", "type": "Bool", "optional": true, "description": "Switch the controller to manual" }
    ],
    "OUT": [
      { "name": "start_request", "type": "Bool", "description": "Start the engine" },
      { "name": "stop_request", "type": "Bool", "description": "Stop the engine" },
      { "name": "reset_request", "type": "Bool", "description": "Controller alarm reset (pulse)" },
      { "name": "auto_request", "type": "Bool", "optional": true, "description": "Pulse for CMD.set_auto" },
      { "name": "manual_request", "type": "Bool", "optional": true, "description": "Pulse for CMD.set_manual" }
    ],
    "LOK": [
      { "name": "can_on", "type": "Bool", "initial": true, "description": "May start" },
      { "name": "trip", "type": "Bool", "initial": false, "description": "Forces a stop (trip)" },
      { "name": "can_off", "type": "Bool", "initial": true, "description": "May stop" },
      { "name": "can_on_status", "type": "Int32", "initial": 0, "description": "Bit n = Switch on interlock n met" },
      { "name": "can_off_status", "type": "Int32", "initial": 0, "description": "Bit n = Switch off interlock n met" }
    ],
    "PAR": [
      { "name": "max_start_time", "type": "Real", "unit": "s", "initial": 30, "description": "Start request to running, including crank attempts" },
      { "name": "max_stop_time", "type": "Real", "unit": "s", "initial": 60, "description": "Stop request to not running" },
      { "name": "cooldown_time", "type": "Real", "unit": "s", "initial": 180, "description": "Unloaded running time before stop" },
      { "name": "stable_time", "type": "Real", "unit": "s", "initial": 5, "description": "Voltage and frequency in range before ReadyToConnect" },
      { "name": "coolant_temp_H", "type": "Real", "unit": "°C", "initial": 90, "description": "Coolant temperature high" },
      { "name": "coolant_temp_HH", "type": "Real", "unit": "°C", "initial": 95, "description": "Coolant temperature high-high" },
      { "name": "lube_oil_pressure_L", "type": "Real", "unit": "bar", "initial": 2.5, "description": "Lube oil pressure low" },
      { "name": "lube_oil_pressure_LL", "type": "Real", "unit": "bar", "initial": 1.5, "description": "Lube oil pressure low-low" },
      { "name": "oil_pressure_delay", "type": "Real", "unit": "s", "initial": 10, "description": "Oil pressure alarms active after running this long" },
      { "name": "lube_oil_temp_H", "type": "Real", "unit": "°C", "initial": 105, "description": "Lube oil temperature high" },
      { "name": "exhaust_temp_H", "type": "Real", "unit": "°C", "initial": 500, "optional": true, "description": "Exhaust temperature high" },
      { "name": "battery_voltage_L", "type": "Real", "unit": "V", "initial": 22, "description": "Battery voltage low (24 V system)" },
      { "name": "overload_pct", "type": "Real", "unit": "%", "initial": 100, "description": "Overload warning limit" },
      { "name": "overload_delay", "type": "Real", "unit": "s", "initial": 10, "description": "Overload warning delay" },
      { "name": "voltage_tol_pct", "type": "Real", "unit": "%", "initial": 5, "description": "Allowed voltage deviation from rated" },
      { "name": "frequency_tol_pct", "type": "Real", "unit": "%", "initial": 2, "description": "Allowed frequency deviation from rated" },
      { "name": "service_interval", "type": "Real", "unit": "h", "initial": 500, "description": "Service reminder" },
      { "name": "mean_time_to_failure", "type": "Real", "unit": "h", "description": "Useful life" },
      { "name": "mean_switch_count_to_failure", "type": "Int32", "description": "Useful life in starts" }
    ],
    "SET": [
      { "name": "rated_power", "type": "Real", "unit": "kW", "initial": 500, "description": "Nameplate power" },
      { "name": "rated_voltage", "type": "Real", "unit": "V", "initial": 400, "description": "Nameplate voltage" },
      { "name": "rated_frequency", "type": "Enum", "enum": "Frequency", "initial": "Hz50", "description": "Nameplate frequency" },
      { "name": "standby", "type": "Bool", "initial": false, "description": "Selected as standby (PMS Unit)" },
      { "name": "priority", "type": "Int16", "initial": 0, "description": "Start priority (PMS Unit)" },
      { "name": "cooldown_enabled", "type": "Bool", "initial": true, "description": "Run the cooldown on a normal stop" }
    ],
    "PMT": [
      { "name": "running_hours", "type": "Real", "unit": "h", "description": "Total running hours" },
      { "name": "start_count", "type": "Int32", "description": "Successful starts" },
      { "name": "failed_start_count", "type": "Int32", "description": "Fail-to-start events" },
      { "name": "hours_since_service", "type": "Real", "unit": "h", "description": "Reset by an engineer after service" },
      { "name": "energy", "type": "Real", "unit": "kWh", "description": "Energy produced" },
      { "name": "avg_load_pct", "type": "Real", "unit": "%", "description": "Rolling average load while connected" }
    ],
    "STS": [
      { "name": "load_pct", "type": "Real", "unit": "%", "description": "active_power / rated_power × 100" },
      { "name": "cooldown_remaining", "type": "Real", "unit": "s", "description": "Remaining cooldown time" }
    ],
    "INT": [
      { "name": "state_timer", "type": "Real", "unit": "s", "description": "Time in the current state" },
      { "name": "running_timer", "type": "Real", "unit": "s", "description": "Time since running rose" },
      { "name": "stable_timer", "type": "Real", "unit": "s", "description": "Time voltage and frequency have been in range" },
      { "name": "shutdown_latched", "type": "Bool", "description": "Latched shutdown, cleared by CMD.reset" },
      { "name": "reporting", "type": "Bool", "description": "Controller inputs have good quality" },
      { "name": "v_ok", "type": "Bool", "description": "Voltage within PAR.voltage_tol_pct of rated" },
      { "name": "f_ok", "type": "Bool", "description": "Frequency within PAR.frequency_tol_pct of rated" },
      { "name": "unloaded", "type": "Bool", "description": "Active power below 1 % of rated: the breaker is open" },
      { "name": "fast_stop", "type": "Bool", "description": "Stop without cooldown because LOK.trip went true" }
    ]
  },
  "logic": {
    "plant": [
      { "set": "FIN.in_auto", "expr": "TRUE" },
      { "set": "FIN.ready", "expr": "NOT FIN.shutdown_active" },
      { "block": "TON", "id": "engine", "in": { "IN": "(OUT.start_request OR FIN.running) AND NOT OUT.stop_request AND NOT FIN.shutdown_active", "PT": 3 }, "out": { "Q": "FIN.running" } },
      { "set": "FIN.frequency", "expr": "SEL(FIN.running, 0, SET.rated_frequency)" },
      { "set": "FIN.speed", "expr": "FIN.frequency * 30" },
      { "set": "FIN.voltage", "expr": "SEL(FIN.running, 0, SET.rated_voltage)" },
      { "set": "FIN.coolant_temp", "expr": "SEL(FIN.running, 40, 80)" },
      { "set": "FIN.lube_oil_temp", "expr": "SEL(FIN.running, 40, 85)" },
      { "set": "FIN.lube_oil_pressure", "expr": "SEL(FIN.running, 0, 4.5)" },
      { "set": "FIN.exhaust_temp", "expr": "SEL(FIN.running, 20, 380)" },
      { "set": "FIN.battery_voltage", "expr": "26.4" }
    ],
    "before": [
      { "set": "INT.reporting", "expr": "GOOD(FIN.running) AND GOOD(FIN.ready) AND GOOD(FIN.in_auto) AND GOOD(FIN.shutdown_active)" },
      { "set": "STS.remote_ok", "expr": "SEL(INT.reporting, FALSE, STS.enabled AND INT.in_auto)" },
      { "set": "INT.v_ok", "expr": "FIN.voltage >= SET.rated_voltage * (1 - PAR.voltage_tol_pct / 100) AND FIN.voltage <= SET.rated_voltage * (1 + PAR.voltage_tol_pct / 100)" },
      { "set": "INT.f_ok", "expr": "FIN.frequency >= SET.rated_frequency * (1 - PAR.frequency_tol_pct / 100) AND FIN.frequency <= SET.rated_frequency * (1 + PAR.frequency_tol_pct / 100)" },
      { "set": "INT.unloaded", "expr": "FIN.active_power < SET.rated_power * 0.01" },
      { "set": "INT.running_timer", "expr": "time(INT.running)" },
      { "set": "INT.stable_timer", "expr": "time(INT.running AND INT.v_ok AND INT.f_ok)" },
      { "block": "SR", "id": "shutdown_latch", "in": { "S1": "INT.shutdown_active", "R": "CMD.reset" }, "out": { "Q1": "INT.shutdown_latched" } },
      { "block": "SR", "id": "fast_stop_latch", "in": { "S1": "(is_running OR is_stopping) AND STS.remote_ok AND LOK.trip", "R": "NOT is_running AND NOT is_stopping" }, "out": { "Q1": "INT.fast_stop" } },
      { "block": "CTU", "id": "failed_starts", "in": { "CU": "STS.state = Starting AND STATE_TIME() > PAR.max_start_time" }, "out": { "CV": "PMT.failed_start_count" } }
    ],
    "stateMachine": {
      "transitions": [
        { "from": "*", "to": "Unavailable", "priority": 0, "guard": "NOT STS.enabled OR NOT INT.reporting", "name": "disabled or not reporting" },
        { "from": "Unavailable", "to": "Running", "priority": 1, "guard": "STS.enabled AND INT.reporting AND INT.running", "name": "reporting again, running" },
        { "from": "Unavailable", "to": "Stopped", "priority": 2, "guard": "STS.enabled AND INT.reporting", "name": "reporting again" },
        { "from": ["Starting", "Running", "Stopping"], "to": "Shutdown", "priority": 1, "guard": "INT.shutdown_active", "name": "engine shutdown" },
        { "from": "Shutdown", "to": "Stopped", "priority": 1, "guard": "NOT INT.shutdown_latched", "name": "reset" },
        { "from": ["Stopped", "Available"], "to": "Running", "priority": 2, "guard": "INT.running", "name": "started locally" },
        { "from": "Stopped", "to": "Available", "priority": 3, "guard": "INT.ready AND NOT INT.shutdown_active", "name": "ready" },
        { "from": "Available", "to": "Stopped", "priority": 3, "guard": "NOT INT.ready OR INT.shutdown_active", "name": "not ready" },
        { "from": "Available", "to": "Starting", "priority": 4, "guard": "STS.remote_ok AND LOK.can_on AND CMD.set_on", "name": "start" },
        { "from": "Starting", "to": "Running", "priority": 2, "guard": "INT.running", "name": "running" },
        { "from": "Starting", "to": "Stopped", "priority": 3, "guard": "STATE_TIME() > PAR.max_start_time", "name": "fail to start" },
        { "from": "Starting", "to": "Stopped", "priority": 4, "guard": "NOT STS.remote_ok OR (CMD.set_off AND LOK.can_off)", "name": "start aborted" },
        { "from": "Running", "to": "Stopping", "priority": 2, "guard": "STS.remote_ok AND ((CMD.set_off AND LOK.can_off) OR LOK.trip)", "name": "stop" },
        { "from": "Running", "to": "Stopped", "priority": 3, "guard": "NOT INT.running", "name": "stopped unexpectedly" },
        { "from": "Running", "to": "ReadyToConnect", "priority": 4, "guard": "INT.stable_timer > PAR.stable_time", "name": "voltage and frequency stable" },
        { "from": "ReadyToConnect", "to": "Running", "priority": 4, "guard": "NOT (INT.v_ok AND INT.f_ok)", "name": "voltage or frequency out of range" },
        { "from": "Stopping", "to": "Stopped", "priority": 2, "guard": "NOT INT.running", "name": "engine stopped" },
        { "from": "Stopping", "to": "Running", "priority": 3, "guard": "NOT STS.remote_ok AND INT.running", "name": "taken over locally" },
        { "from": "Stopping", "to": "CoolingDown", "priority": 4, "guard": "INT.unloaded AND SET.cooldown_enabled AND NOT INT.fast_stop", "name": "breaker open" }
      ],
      "outputs": {
        "OUT.start_request": { "states": ["Starting"], "when": "STS.remote_ok" },
        "OUT.stop_request": { "states": ["Stopping"], "when": "STS.remote_ok AND SEL(STS.state = CoolingDown, INT.fast_stop OR (INT.unloaded AND NOT SET.cooldown_enabled), INT.fast_stop OR STATE_TIME() >= PAR.cooldown_time)" },
        "OUT.reset_request": "CMD.reset AND INT.reporting",
        "OUT.auto_request": "CMD.set_auto AND STS.enabled AND INT.reporting",
        "OUT.manual_request": "CMD.set_manual AND STS.enabled AND INT.reporting"
      }
    },
    "after": [
      { "set": "INT.state_timer", "expr": "STATE_TIME()" },
      { "set": "STS.load_pct", "expr": "FIN.active_power / MAX(SET.rated_power, 1) * 100" },
      { "set": "STS.cooldown_remaining", "expr": "SEL(STS.state = CoolingDown, 0, MAX(0, PAR.cooldown_time - STATE_TIME()))" },
      { "block": "CTU", "id": "starts", "in": { "CU": "INT.running" }, "out": { "CV": "PMT.start_count" } },
      { "block": "RUNTIME", "id": "running_hours", "in": { "IN": "INT.running" }, "out": { "HOURS": "PMT.running_hours" } },
      { "block": "RUNTIME", "id": "hours_since_service", "in": { "IN": "INT.running" }, "out": { "HOURS": "PMT.hours_since_service" } }
    ]
  },
  "alarms": [
    {"name": "FailToStart", "severity": 25, "message": {"en": "Fail to start"}, "onTransition": "fail to start", "latch": true},
    {"name": "FailToStop", "severity": 25, "message": {"en": "Fail to stop"}, "watchdog": {"while": "STS.state = Stopping AND OUT.stop_request AND INT.running", "timeout": "PAR.max_stop_time"}},
    {"name": "StoppedUnexpectedly", "severity": 25, "message": {"en": "Stopped unexpectedly"}, "onTransition": "stopped unexpectedly", "condition": "STS.remote_ok"},
    {"name": "EngineShutdown", "severity": 30, "message": {"en": "Engine shutdown"}, "condition": "INT.shutdown_active", "latch": true},
    {"name": "ControllerCommunicationLost", "severity": 25, "message": {"en": "Controller communication lost"}, "condition": "NOT INT.reporting"},
    {"name": "ControllerCommonAlarm", "severity": 20, "message": {"en": "Controller common alarm"}, "condition": "INT.common_alarm"},
    {"name": "ControllerCommonWarning", "severity": 10, "message": {"en": "Controller common warning"}, "condition": "INT.common_warning"},
    {"name": "CoolantTempHigh", "severity": 10, "message": {"en": "Coolant temperature high"}, "limit": {"input": "FIN.coolant_temp", "above": "PAR.coolant_temp_H"}},
    {"name": "CoolantTempHighHigh", "severity": 25, "message": {"en": "Coolant temperature high-high"}, "limit": {"input": "FIN.coolant_temp", "above": "PAR.coolant_temp_HH"}},
    {"name": "LubeOilPressureLow", "severity": 10, "message": {"en": "Lube oil pressure low"}, "condition": "INT.running AND INT.running_timer > PAR.oil_pressure_delay AND FIN.lube_oil_pressure < PAR.lube_oil_pressure_L"},
    {"name": "LubeOilPressureLowLow", "severity": 25, "message": {"en": "Lube oil pressure low-low"}, "condition": "INT.running AND INT.running_timer > PAR.oil_pressure_delay AND FIN.lube_oil_pressure < PAR.lube_oil_pressure_LL"},
    {"name": "LubeOilTempHigh", "severity": 10, "message": {"en": "Lube oil temperature high"}, "limit": {"input": "FIN.lube_oil_temp", "above": "PAR.lube_oil_temp_H"}},
    {"name": "ExhaustTempHigh", "severity": 10, "message": {"en": "Exhaust temperature high"}, "limit": {"input": "FIN.exhaust_temp", "above": "PAR.exhaust_temp_H"}, "requires": "FIN.exhaust_temp"},
    {"name": "BatteryVoltageLow", "severity": 10, "message": {"en": "Battery voltage low"}, "limit": {"input": "FIN.battery_voltage", "below": "PAR.battery_voltage_L"}},
    {"name": "Overload", "severity": 20, "message": {"en": "Overload"}, "limit": {"input": "STS.load_pct", "above": "PAR.overload_pct", "delay": "PAR.overload_delay"}},
    {"name": "VoltageOutOfRange", "severity": 15, "message": {"en": "Voltage out of range"}, "condition": "INT.running_timer > PAR.stable_time AND NOT INT.v_ok"},
    {"name": "FrequencyOutOfRange", "severity": 15, "message": {"en": "Frequency out of range"}, "condition": "INT.running_timer > PAR.stable_time AND NOT INT.f_ok"},
    {"name": "NotInAuto", "severity": 5, "message": {"en": "Controller not in auto"}, "condition": "STS.enabled AND NOT INT.in_auto"},
    {"name": "ServiceDue", "severity": 0, "message": {"en": "Service due"}, "condition": "PMT.hours_since_service > PAR.service_interval", "runsOn": "SCADA"},
    {"name": "UsefulLifeReached", "severity": 0, "message": {"en": "Useful life reached"}, "condition": "PMT.running_hours > PAR.mean_time_to_failure OR PMT.start_count > PAR.mean_switch_count_to_failure", "runsOn": "SCADA"}
  ]
}
