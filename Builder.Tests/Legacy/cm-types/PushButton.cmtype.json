{
  "schema": "apolloiq.cmtype/1",
  "name": "PushButton",
  "version": "1.0.0",
  "description": "Hardwired push button or switch, used as a command source (wire it to a CM with On, Off, Toggle or Maintained)",
  "tags": {
    "FIN": [
      { "name": "pressed", "type": "Bool", "description": "Contact closed" }
    ]
  },
  "logic": {
    "stateMachine": {
      "transitions": [
        { "from": "*", "to": "Unavailable", "priority": 0, "guard": "NOT STS.enabled OR NOT GOOD(FIN.pressed)", "name": "disabled or input bad" },
        { "from": ["Stopped", "Available", "Unavailable"], "to": "Running", "priority": 1, "guard": "STS.enabled AND INT.pressed", "name": "pressed" },
        { "from": ["Stopped", "Unavailable"], "to": "Available", "priority": 2, "guard": "STS.enabled AND GOOD(FIN.pressed) AND NOT INT.pressed", "name": "ready" },
        { "from": "Running", "to": "Available", "priority": 1, "guard": "NOT INT.pressed", "name": "released" }
      ]
    },
    "after": [
      { "set": "STS.remote_ok", "expr": "FALSE" }
    ]
  }
}
