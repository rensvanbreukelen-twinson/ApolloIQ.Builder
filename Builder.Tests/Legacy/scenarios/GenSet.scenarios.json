{
  "schema": "apolloiq.scenarios/1",
  "type": "GenSet",
  "scenarios": [
    {
      "name": "Normal start and stop with cooldown",
      "steps": [
        { "run": "0.2 s" },
        { "expect": ["STS.state = Available", "STS.remote_ok"] },
        { "set": { "CMD.set_on": true, "PAR.cooldown_time": 2 } },
        { "run": 1 },
        { "expect": ["STS.state = Starting", "OUT.start_request"] },
        { "until": "STS.state = Running", "within": "5 s" },
        { "expect": "NOT OUT.start_request" },
        { "until": "STS.state = ReadyToConnect", "within": "7 s" },
        { "set": { "CMD.set_off": true } },
        { "run": 1 },
        { "expect": "STS.state = 100" },
        { "until": "STS.state = CoolingDown", "within": 2 },
        { "expect": "NOT OUT.stop_request" },
        { "until": "OUT.stop_request", "within": "3 s" },
        { "until": "STS.state = Available", "within": "1 s" },
        { "expect": ["PMT.start_count = 1", "NOT FIN.running"] }
      ]
    },
    {
      "name": "Voltage out of range leaves ReadyToConnect",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "until": "STS.state = ReadyToConnect", "within": "10 s" },
        { "force": { "FIN.voltage": 300 } },
        { "run": 1 },
        { "expect": ["STS.state = 400", "NOT INT.v_ok"] },
        { "release": "FIN.voltage" },
        { "until": "STS.state = ReadyToConnect", "within": "6 s" }
      ]
    },
    {
      "name": "Losing running conditions stops without cooldown",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "until": "STS.state = ReadyToConnect", "within": "10 s" },
        { "force": { "LOK.trip": true } },
        { "run": 1 },
        { "expect": ["STS.state = 100", "OUT.stop_request", "INT.fast_stop"] },
        { "until": "STS.state = Stopped", "within": "0.5 s" },
        { "run": 1 },
        { "expect": ["STS.state = Available", "NOT INT.fast_stop"] }
      ]
    },
    {
      "name": "Cooldown waits until the generator is unloaded",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "until": "STS.state = ReadyToConnect", "within": "10 s" },
        { "force": { "FIN.active_power": 300 } },
        { "set": { "CMD.set_off": true } },
        { "run": "2 s" },
        { "expect": ["STS.state = 100", "STS.load_pct = 60", "NOT OUT.stop_request"] },
        { "release": "FIN.active_power" },
        { "until": "STS.state = CoolingDown", "within": 3 }
      ]
    },
    {
      "name": "Fail to start",
      "steps": [
        { "set": { "PAR.max_start_time": 1 } },
        { "force": { "FIN.running": false } },
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "run": 1 },
        { "expect": "STS.state = Starting" },
        { "until": "STS.state = Stopped", "within": "1.5 s" },
        { "expect": "PMT.failed_start_count = 1" },
        { "run": 1 },
        { "expect": "STS.state = Available" },
        { "expect": ["ALM.FailToStart.active", "ALM.FailToStart.raise_count = 1"] },
        { "set": { "CMD.reset": true } },
        { "run": 1 },
        { "expect": "NOT ALM.FailToStart.active" }
      ]
    },
    {
      "name": "Start aborted when the controller goes to manual",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "run": 1 },
        { "force": { "FIN.in_auto": false } },
        { "run": 2 },
        { "expect": ["STS.state = Available", "NOT OUT.start_request"] }
      ]
    },
    {
      "name": "Engine stopped unexpectedly",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "until": "STS.state = ReadyToConnect", "within": "10 s" },
        { "force": { "FIN.running": false } },
        { "run": 1 },
        { "expect": "STS.state = Stopped" },
        { "expect": "ALM.StoppedUnexpectedly.raise_count = 1" }
      ]
    },
    {
      "name": "Shutdown latches until reset",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "until": "STS.state = Running", "within": "5 s" },
        { "set": { "FIN.shutdown_active": true } },
        { "run": 1 },
        { "expect": ["STS.state = Shutdown", "INT.shutdown_latched"] },
        { "expect": "ALM.EngineShutdown.active" },
        { "run": "0.2 s" },
        { "expect": "NOT FIN.running" },
        { "set": { "CMD.reset": true } },
        { "run": 1 },
        { "expect": "STS.state = Shutdown" },
        { "set": { "FIN.shutdown_active": false } },
        { "run": "0.2 s" },
        { "expect": "STS.state = Shutdown" },
        { "set": { "CMD.reset": true } },
        { "run": 1 },
        { "expect": ["STS.state = Stopped", "OUT.reset_request"] },
        { "run": 1 },
        { "expect": ["STS.state = Available", "NOT OUT.reset_request"] },
        { "expect": "NOT ALM.EngineShutdown.active" }
      ]
    },
    {
      "name": "Manual mode ignores commands and tracks the engine",
      "steps": [
        { "force": { "FIN.in_auto": false } },
        { "run": "0.2 s" },
        { "expect": ["STS.state = Available", "NOT STS.remote_ok"] },
        { "set": { "CMD.set_on": true } },
        { "run": 1 },
        { "expect": ["STS.state = Available", "NOT OUT.start_request"] },
        { "force": { "FIN.running": true } },
        { "run": 1 },
        { "expect": "STS.state = Running" },
        { "set": { "CMD.set_off": true } },
        { "run": 1 },
        { "expect": "STS.state = Running" },
        { "force": { "FIN.running": false } },
        { "run": 2 },
        { "expect": "STS.state = Available" },
        { "expect": ["ALM.NotInAuto.active", "ALM.StoppedUnexpectedly.raise_count = 0"] }
      ]
    },
    {
      "name": "Taken over locally while stopping",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "until": "STS.state = ReadyToConnect", "within": "10 s" },
        { "force": { "FIN.active_power": 300 } },
        { "set": { "CMD.set_off": true } },
        { "run": 1 },
        { "expect": "STS.state = 100" },
        { "force": { "FIN.in_auto": false } },
        { "run": 1 },
        { "expect": "STS.state = 400" }
      ]
    },
    {
      "name": "Communication lost and restored while stopped",
      "steps": [
        { "run": "0.2 s" },
        { "bad": "FIN.running" },
        { "run": 1 },
        { "expect": "ALM.ControllerCommunicationLost.active" },
        { "expect": ["STS.state = Unavailable", "NOT STS.remote_ok", "GOOD(STS.remote_ok)"] },
        { "good": "FIN.running" },
        { "run": 1 },
        { "expect": "STS.state = Stopped" },
        { "run": 1 },
        { "expect": "STS.state = Available" }
      ]
    },
    {
      "name": "Communication lost and restored while running",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "until": "STS.state = ReadyToConnect", "within": "10 s" },
        { "bad": "FIN.ready" },
        { "run": 1 },
        { "expect": "STS.state = Unavailable" },
        { "good": "FIN.ready" },
        { "run": 1 },
        { "expect": "STS.state = 400" }
      ]
    },
    {
      "name": "Controller not ready",
      "steps": [
        { "run": "0.2 s" },
        { "force": { "FIN.ready": false } },
        { "run": 1 },
        { "expect": "STS.state = Stopped" },
        { "set": { "CMD.set_on": true } },
        { "run": 1 },
        { "expect": "STS.state = Stopped" },
        { "release": "FIN.ready" },
        { "run": 2 },
        { "expect": "STS.state = Available" }
      ]
    },
    {
      "name": "Disabled genset is unavailable",
      "steps": [
        { "run": "0.2 s" },
        { "force": { "STS.enabled": false } },
        { "run": 1 },
        { "expect": ["STS.state = Unavailable", "NOT STS.remote_ok"] },
        { "release": "STS.enabled" },
        { "run": 2 },
        { "expect": "STS.state = Available" }
      ]
    },
    {
      "name": "Stop is ignored when stopping is not allowed",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "until": "STS.state = ReadyToConnect", "within": "10 s" },
        { "force": { "LOK.can_off": false } },
        { "set": { "CMD.set_off": true } },
        { "run": 2 },
        { "expect": "STS.state = ReadyToConnect" }
      ]
    },
    {
      "name": "Optional controller mode commands pulse the outputs",
      "instances": [{ "name": "CM", "optionalTags": ["CMD.set_auto", "CMD.set_manual", "OUT.auto_request", "OUT.manual_request"] }],
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_manual": true } },
        { "run": 1 },
        { "expect": ["OUT.manual_request", "NOT OUT.auto_request"] },
        { "run": 1 },
        { "expect": "NOT OUT.manual_request" }
      ]
    },
    {
      "name": "Coolant temperature alarms and disabling an alarm",
      "steps": [
        { "run": "0.2 s" },
        { "force": { "FIN.coolant_temp": 92 } },
        { "run": 1 },
        { "expect": ["ALM.CoolantTempHigh.active", "NOT ALM.CoolantTempHighHigh.active"] },
        { "force": { "FIN.coolant_temp": 96 } },
        { "run": 1 },
        { "expect": ["ALM.CoolantTempHigh.active", "ALM.CoolantTempHighHigh.active"] },
        { "set": { "ALM.CoolantTempHigh.enabled": false } },
        { "run": 1 },
        { "expect": ["NOT ALM.CoolantTempHigh.active", "ALM.CoolantTempHighHigh.active"] },
        { "release": "FIN.coolant_temp" },
        { "run": 1 },
        { "expect": "NOT ALM.CoolantTempHighHigh.active" }
      ]
    },
    {
      "name": "Overload after its delay",
      "steps": [
        { "run": "0.2 s" },
        { "set": { "CMD.set_on": true } },
        { "until": "STS.state = ReadyToConnect", "within": "10 s" },
        { "force": { "FIN.active_power": 600 } },
        { "run": "9.5 s" },
        { "expect": ["STS.load_pct = 120", "NOT ALM.Overload.active"] },
        { "run": "1 s" },
        { "expect": "ALM.Overload.active" }
      ]
    }
  ]
}
